<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Comes with the desktop shell's WebView2 package (see TimeSheetHelper.Desktop.csproj). -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TimeSheetHelper.Core\TimeSheetHelper.Core.csproj" />
    <ProjectReference Include="..\..\src\TimeSheetHelper.Storage\TimeSheetHelper.Storage.csproj" />
    <ProjectReference Include="..\..\src\TimeSheetHelper.Collectors.Windows\TimeSheetHelper.Collectors.Windows.csproj" />
    <ProjectReference Include="..\..\src\TimeSheetHelper.Collectors.Microsoft365\TimeSheetHelper.Collectors.Microsoft365.csproj" />
    <ProjectReference Include="..\..\src\TimeSheetHelper.Forecast\TimeSheetHelper.Forecast.csproj" />
    <ProjectReference Include="..\..\src\TimeSheetHelper.Collectors.DevOps\TimeSheetHelper.Collectors.DevOps.csproj" />
    <ProjectReference Include="..\..\src\TimeSheetHelper.Engine\TimeSheetHelper.Engine.csproj" />
    <ProjectReference Include="..\..\src\TimeSheetHelper.App\TimeSheetHelper.App.csproj" />
    <ProjectReference Include="..\..\src\TimeSheetHelper.Desktop\TimeSheetHelper.Desktop.csproj" />
    <ProjectReference Include="..\..\src\TimeSheetHelper.Plugins.Abstractions\TimeSheetHelper.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\TimeSheetHelper.TestPlugin\TimeSheetHelper.TestPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The plugins bundled with the application are staged in the application's own output: bring them next to the tests. -->
  <Target Name="CopyBundledPluginsForTests" AfterTargets="Build">
    <ItemGroup>
      <_AppReference Include="@(ReferencePath)" Condition="'%(Filename)' == 'TimeSheetHelper'" />
    </ItemGroup>
    <PropertyGroup>
      <_AppOutDir>@(_AppReference->'%(RootDir)%(Directory)')</_AppOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_BundledPluginFile Include="$(_AppOutDir)plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BundledPluginFile)"
          DestinationFiles="@(_BundledPluginFile->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>