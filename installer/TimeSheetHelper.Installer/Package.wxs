<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    Per-user installation (no administrator rights): the application, its window and the bundled source plugins go to
    %LOCALAPPDATA%\Programs\TimeSheetHelper. Data (%LOCALAPPDATA%\TimeSheetHelper), secrets (Credential Manager) and
    appsettings.Local.json are never installed by this package, so upgrading or uninstalling leaves them alone.
  -->
  <Package Name="Time Sheet Helper"
           Manufacturer="Time Sheet Helper"
           Version="$(var.ProductVersion)"
           UpgradeCode="6E2F6E3B-4C0B-4B7B-8D51-3B2C9A7E5F10"
           Language="1036"
           Scope="perUser"
           InstallerVersion="500">

    <SummaryInformation Description="Time Sheet Helper : propose votre feuille de temps à partir de votre activité." />

    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de Time Sheet Helper est déjà installée." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Set to 0 on the command line (AUTOLAUNCH=0) for silent deployments that must not start the application. -->
    <Property Id="AUTOLAUNCH" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="TimeSheetHelper" />
      </Directory>
    </StandardDirectory>

    <!-- The running application and window hold their files: close them for an upgrade or an uninstall. -->
    <util:CloseApplication Id="CloseWindow" Target="TimeSheetHelper.Desktop.exe" CloseMessage="yes" RebootPrompt="no" TerminateProcess="0" />
    <util:CloseApplication Id="CloseHost" Target="TimeSheetHelper.exe" CloseMessage="no" RebootPrompt="no" TerminateProcess="0" />

    <Feature Id="Main" Title="Time Sheet Helper" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="Executables" />
      <ComponentGroupRef Id="AppFiles" />
      <?ifdef VsixPath ?>
      <ComponentRef Id="VsCodeExtensionFile" />
      <?endif?>
    </Feature>

    <!-- The background application (tray icon, web server, sources) starts with the user's Windows session. -->
    <ComponentGroup Id="Executables" Directory="INSTALLFOLDER">
      <Component Id="HostExe">
        <File Id="HostExeFile" Source="$(var.AppSourceDir)\TimeSheetHelper.exe" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="TimeSheetHelper"
                       Type="string" Value="&quot;[INSTALLFOLDER]TimeSheetHelper.exe&quot;" />
      </Component>
      <Component Id="DesktopExe">
        <File Id="DesktopExeFile" Source="$(var.AppSourceDir)\TimeSheetHelper.Desktop.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Time Sheet Helper"
                    Description="Ouvre la feuille de temps" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        </File>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppSourceDir)\**">
        <Exclude Files="$(var.AppSourceDir)\TimeSheetHelper.exe" />
        <Exclude Files="$(var.AppSourceDir)\TimeSheetHelper.Desktop.exe" />
        <Exclude Files="$(var.AppSourceDir)\appsettings.Local.json" />
        <Exclude Files="$(var.AppSourceDir)\appsettings.Development.json" />
        <Exclude Files="$(var.AppSourceDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <?ifdef VsixPath ?>
    <Component Id="VsCodeExtensionFile" Directory="INSTALLFOLDER" Subdirectory="vscode">
      <File Id="VsixFile" Source="$(var.VsixPath)" KeyPath="yes" />
    </Component>

    <!-- Best effort: nothing happens when VS Code is not installed. -->
    <CustomAction Id="InstallVsCodeExtension" Directory="INSTALLFOLDER" Execute="immediate" Return="ignore" Impersonate="yes"
                  ExeCommand="cmd.exe /c code --install-extension &quot;[INSTALLFOLDER]vscode\$(var.VsixName)&quot; --force" />
    <CustomAction Id="UninstallVsCodeExtension" Directory="INSTALLFOLDER" Execute="immediate" Return="ignore" Impersonate="yes"
                  ExeCommand="cmd.exe /c code --uninstall-extension $(var.ExtensionId)" />
    <?endif?>

    <CustomAction Id="LaunchHost" Directory="INSTALLFOLDER" Execute="immediate" Return="asyncNoWait" Impersonate="yes"
                  ExeCommand="&quot;[INSTALLFOLDER]TimeSheetHelper.exe&quot;" />

    <InstallExecuteSequence>
      <Custom Action="LaunchHost" After="InstallFinalize" Condition="NOT REMOVE AND AUTOLAUNCH = &quot;1&quot;" />
      <?ifdef VsixPath ?>
      <Custom Action="InstallVsCodeExtension" After="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="UninstallVsCodeExtension" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <?endif?>
    </InstallExecuteSequence>

  </Package>
</Wix>
