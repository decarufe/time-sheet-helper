{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Urls": "http://localhost:5178",
  "Microsoft365": {
    "TenantId": "",
    "ClientId": "",
    "UseBroker": true,
    "MaxChats": 50,
    "InternalDomains": []
  },
  "GitHub": {
    "Organizations": []
  },
  "AzureDevOps": {
    "Organizations": []
  },
  "LocalGit": {
    "Roots": [ "C:\git*" ],
    "ScanDepth": 2
  },
  "FocusTracker": {
    "IdleThreshold": "00:05:00",
    "ExcludedProcesses": [ "KeePass", "1Password" ],
    "ExcludedTitleKeywords": [ "InPrivate", "Incognito" ]
  }
}
