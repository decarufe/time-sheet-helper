@using TimeSheetHelper.Forecast
@* Per-cell report of a Forecast simulation or fill. *@

<section class="report">
    <div class="report-head">
        <h2>@Title</h2>
        <span class="summary @(Report.Success ? "ok" : "bad")">@Report.Summary</span>
    </div>

    @if (Report.Warnings.Count > 0)
    {
        <ul class="warnings">
            @foreach (var warning in Report.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    }

    @if (Report.Cells.Count > 0)
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Tâche</th>
                        <th>Jour</th>
                        <th class="num">Attendu</th>
                        <th class="num">Lu dans Forecast</th>
                        <th>Statut</th>
                        <th>Détail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cell in Report.Cells)
                    {
                        <tr>
                            <td>@cell.TaskDisplayName</td>
                            <td class="nowrap">@UiLabels.Day(cell.Date)</td>
                            <td class="num">@UiLabels.Hours(cell.Expected)</td>
                            <td class="num">@(cell.Actual is { } actual ? UiLabels.Hours(actual) : "—")</td>
                            <td><span class="status status-@cell.Status.ToString().ToLowerInvariant()">@UiLabels.CellStatus(cell.Status)</span></td>
                            <td class="message">
                                @cell.Message
                                @if (OnRelink.HasDelegate && cell.Status == ForecastCellStatus.RowNotFound)
                                {
                                    <button class="relink" disabled="@RelinkDisabled" @onclick="() => OnRelink.InvokeAsync(cell)">Rechercher et relier…</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public ForecastFillReport Report { get; set; } = default!;
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>When set, a cell whose task was not found in Forecast offers to search for it and link it.</summary>
    [Parameter] public EventCallback<ForecastCellResult> OnRelink { get; set; }

    [Parameter] public bool RelinkDisabled { get; set; }
}
