@using TimeSheetHelper.App.Services
@using TimeSheetHelper.Forecast
@* Per-cell report of a Forecast simulation or fill, with links to the screenshots. *@

<section class="report">
    <div class="report-head">
        <h2>@Title</h2>
        <span class="summary @(Report.Success ? "ok" : "bad")">@Report.Summary</span>
    </div>

    @if (Report.Warnings.Count > 0)
    {
        <ul class="warnings">
            @foreach (var warning in Report.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    }

    @if (Report.Cells.Count > 0)
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Tâche</th>
                        <th>Jour</th>
                        <th class="num">Attendu</th>
                        <th class="num">Lu dans Forecast</th>
                        <th>Statut</th>
                        <th>Détail</th>
                        <th>Capture</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cell in Report.Cells)
                    {
                        <tr>
                            <td>@cell.TaskDisplayName</td>
                            <td class="nowrap">@UiLabels.Day(cell.Date)</td>
                            <td class="num">@UiLabels.Hours(cell.Expected)</td>
                            <td class="num">@(cell.ActualText is { Length: > 0 } text ? text : cell.Actual is { } actual ? UiLabels.Hours(actual) : "—")</td>
                            <td><span class="status status-@cell.Status.ToString().ToLowerInvariant()">@UiLabels.CellStatus(cell.Status)</span></td>
                            <td class="message">@cell.Message</td>
                            <td>
                                @if (LocalFolders.ScreenshotUrl(cell.ScreenshotPath) is { } url)
                                {
                                    <a href="@url" target="_blank" rel="noopener">Voir</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="files">
        @foreach (var shot in Report.Screenshots.Distinct())
        {
            @if (LocalFolders.ScreenshotUrl(shot) is { } url)
            {
                <a href="@url" target="_blank" rel="noopener">@Path.GetFileNameWithoutExtension(shot)</a>
            }
        }
        @if (Report.OutputDirectory is { } dir)
        {
            <button @onclick="() => OnOpenFolder.InvokeAsync(dir)">Ouvrir le dossier des captures</button>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public ForecastFillReport Report { get; set; } = default!;
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public EventCallback<string> OnOpenFolder { get; set; }
}
