@using Microsoft.EntityFrameworkCore
@using TimeSheetHelper.Core.Forecast
@using TimeSheetHelper.Engine
@using TimeSheetHelper.Storage
@inject IDbContextFactory<TimeSheetDbContext> DbFactory
@inject WeekService Weeks

<div class="picker-backdrop" @onclick="CancelAsync"></div>
<div class="picker" role="dialog" aria-modal="true" aria-labelledby="@titleId" @onkeydown="OnKeyDownAsync">
    <header>
        <h2 id="@titleId">@Title</h2>
        <button type="button" class="close" @onclick="CancelAsync" aria-label="Fermer">✕</button>
    </header>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <p class="subtitle">@Subtitle</p>
    }

    @if (chosen is not null)
    {
        <div class="comment-step">
            <div class="chosen" style="@TimesheetUi.TaskStyle(chosen.Id)">
                <span class="swatch" aria-hidden="true"></span>
                <span class="name">@chosen.TaskName</span>
                <span class="code">@chosen.ProjectName</span>
                <button type="button" class="link" @onclick="BackToList">Changer de tâche</button>
            </div>
            <label for="@commentId">Commentaire (facultatif)</label>
            <input @ref="commentInput" id="@commentId" type="text" class="comment" maxlength="@WeekService.MaxCommentLength"
                   placeholder="Ce qui a été fait pendant ces créneaux…" autocomplete="off"
                   @bind="comment" @bind:event="oninput" @onkeydown="OnCommentKeyDownAsync" />
            @if (suggestions.Count > 0)
            {
                <div class="suggestions" role="group" aria-label="Commentaires récents pour cette tâche">
                    <span class="muted">Récents :</span>
                    @foreach (var suggestion in suggestions)
                    {
                        <button type="button" class="chip" title="@suggestion" @onclick="() => UseSuggestion(suggestion)">@suggestion</button>
                    }
                </div>
            }
            <div class="buttons">
                <button type="button" class="primary" @onclick="ConfirmAsync">@SubmitLabel</button>
                <button type="button" @onclick="BackToList">Retour</button>
            </div>
        </div>
    }
    else if (creating)
    {
        <NewTaskForm InitialTaskName="@NewTaskName" OnCreated="SelectAsync" OnCancel="() => creating = false" />
    }

    else
    {
    <input @ref="searchInput" type="search" class="search" placeholder="Rechercher une tâche, un projet ou un client…"
           aria-label="Rechercher une tâche" @onkeydown="OnSearchKeyDownAsync" @bind="query" @bind:event="oninput" @bind:after="StateHasChanged" />

    @if (IgnoredTask() is { } ignored && (query.Trim().Length == 0 || TaskPickerView.Contains(ForecastTask.IgnoredLabel, query.Trim())))
    {
        <button type="button" class="@(ignored.Id == SelectedTaskId ? "task ignored current" : "task ignored")"
                title="Retire ces créneaux ou ces réunions de la feuille de temps" @onclick="() => SelectAsync(ignored.Id)">
            <span class="swatch" aria-hidden="true"></span>
            <span class="name">@ForecastTask.IgnoredLabel</span>
            <span class="code">Hors feuille de temps</span>
        </button>
    }

    <div class="toolbar" role="group" aria-label="Affichage des tâches">
        <div class="chips" role="radiogroup" aria-label="Afficher">
            @foreach (var scope in Enum.GetValues<TaskScope>())
            {
                <button type="button" role="radio" aria-checked="@(options.Scope == scope ? "true" : "false")"
                        class="@(options.Scope == scope ? "chip active" : "chip")" @onclick="() => SetOptions(options with { Scope = scope })">
                    @TaskPickerView.ScopeLabel(scope)
                </button>
            }
        </div>
        <label>
            Projet
            <select value="@(options.Project ?? "")" @onchange="e => SetOptions(options with { Project = e.Value as string is { Length: > 0 } p ? p : null })">
                <option value="">Tous</option>
                @foreach (var project in tasks is null ? [] : TaskPickerView.Projects(tasks))
                {
                    <option value="@project">@project</option>
                }
            </select>
        </label>
        <label>
            Regrouper
            <select value="@options.Grouping" @onchange="e => SetOptions(options with { Grouping = Enum.Parse<TaskGrouping>((string)e.Value!) })">
                @foreach (var grouping in Enum.GetValues<TaskGrouping>())
                {
                    <option value="@grouping">@TaskPickerView.GroupingLabel(grouping)</option>
                }
            </select>
        </label>
        <label>
            Trier
            <select value="@options.Sort" @onchange="e => SetOptions(options with { Sort = Enum.Parse<TaskSort>((string)e.Value!) })">
                @foreach (var sort in Enum.GetValues<TaskSort>())
                {
                    <option value="@sort">@TaskPickerView.SortLabel(sort)</option>
                }
            </select>
        </label>
    </div>

    <div class="list">
        @if (tasks is null)
        {
            <p class="muted">Chargement…</p>
        }
        else if (tasks.All(t => t.IsIgnored))
        {
            <p class="muted">Aucune tâche Forecast active. Créez-en une ci-dessous ou synchronisez-les depuis la page <a href="sources">Sources</a>.</p>
        }
        else
        {
            var groups = Groups();
            if (groups.Count == 0)
            {
                <p class="muted">@(query.Trim().Length > 0 ? $"Aucune tâche ne correspond à « {query.Trim()} »." : "Aucune tâche ne correspond à ces filtres.")</p>
            }
            @foreach (var group in groups)
            {
                var showProject = group.IsFavorites || options.Grouping == TaskGrouping.None;
                <section>
                    @if (group.Title is not null)
                    {
                        <h3>
                            @group.Title
                            @if (group.Detail is not null)
                            {
                                <span class="project">· @group.Detail</span>
                            }
                        </h3>
                    }
                    <ul>
                        @foreach (var task in group.Tasks)
                        {
                            var taskDetail = showProject ? task.ProjectName : task.ProjectCode;
                            <li>
                                <button type="button" class="@(task.Id == SelectedTaskId ? "task current" : "task")"
                                        style="@TimesheetUi.TaskStyle(task.Id)" title="@UsageTitle(task)" @onclick="() => SelectAsync(task.Id)">
                                    <span class="swatch" aria-hidden="true"></span>
                                    <span class="name">@task.TaskName</span>
                                    @if (!string.IsNullOrEmpty(taskDetail))
                                    {
                                        <span class="code">@taskDetail</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                </section>
            }
        }
    </div>
    <button type="button" class="new-task-button" @onclick="() => creating = true">
        + Nouvelle tâche@(NewTaskName.Length > 0 ? $" « {NewTaskName} »" : "")
    </button>
    }
</div>

@code {
    private readonly string titleId = $"picker-{Guid.NewGuid():N}";
    private readonly string commentId = $"picker-comment-{Guid.NewGuid():N}";
    // Remembered for the session so the picker reopens with the same view.
    private static TaskPickerOptions lastOptions = new();
    private TaskPickerOptions options = lastOptions;
    private List<ForecastTask>? tasks;
    private IReadOnlyDictionary<int, TaskUsage> usage = new Dictionary<int, TaskUsage>();
    private string query = "";
    private bool creating;
    private ElementReference searchInput;
    private ElementReference commentInput;
    private ForecastTask? chosen;
    private string comment = "";
    private IReadOnlyList<string> suggestions = [];
    private bool focusComment;

    [Parameter] public string Title { get; set; } = "Choisir une tâche";

    /// <summary>Optional context line under the title (what is being assigned).</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Task highlighted as the current choice, if any.</summary>
    [Parameter] public int? SelectedTaskId { get; set; }

    /// <summary>Ask for a comment (with the latest comments of the task as suggestions) after the task is chosen.</summary>
    [Parameter] public bool AllowComment { get; set; }

    /// <summary>Name proposed for a new task when nothing was typed in the search box (e.g. the title of the meeting being assigned).</summary>
    [Parameter] public string? SuggestedTaskName { get; set; }

    private string NewTaskName => query.Trim().Length > 0 ? query.Trim() : SuggestedTaskName?.Trim() ?? "";

    [Parameter] public string SubmitLabel { get; set; } = "Assigner";

    /// <summary>Comment entered with the choice; set before <see cref="OnSelected"/> is raised (null when empty).</summary>
    [Parameter] public string? Comment { get; set; }

    [Parameter] public EventCallback<string?> CommentChanged { get; set; }

    [Parameter] public EventCallback<int> OnSelected { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadTasksAsync();
    }

    private async Task LoadTasksAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        tasks = await db.ForecastTasks.AsNoTracking().Where(t => t.IsActive).ToListAsync();
        usage = await Weeks.GetTaskUsageAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await searchInput.FocusAsync(); }
            catch (Exception) { /* prerendering or disconnected circuit: focus is a nicety */ }
        }
        else if (focusComment)
        {
            focusComment = false;
            try { await commentInput.FocusAsync(); }
            catch (Exception) { /* focus is a nicety */ }
        }
    }

    private IReadOnlyList<TaskPickerGroup> Groups() =>
        tasks is null ? [] : TaskPickerView.Build(tasks, query, options, usage, DateOnly.FromDateTime(DateTime.Now));

    private void SetOptions(TaskPickerOptions value) => options = lastOptions = value;

    private string? UsageTitle(ForecastTask task) =>
        usage.TryGetValue(task.Id, out var u)
            ? $"Utilisée {u.Days} jour{(u.Days > 1 ? "s" : "")}, dernière fois le {u.LastUsed.ToString("d MMMM yyyy", TimesheetUi.French)}"
            : null;

    private ForecastTask? IgnoredTask() => tasks?.FirstOrDefault(t => t.IsIgnored);

    private async Task SelectAsync(int taskId)
    {
        if (!AllowComment || tasks?.Any(t => t.Id == taskId && t.IsIgnored) == true)
        {
            await OnSelected.InvokeAsync(taskId);
            return;
        }

        if (tasks is null || tasks.All(t => t.Id != taskId))
            await LoadTasksAsync();
        chosen = tasks?.FirstOrDefault(t => t.Id == taskId);
        if (chosen is null)
        {
            await OnSelected.InvokeAsync(taskId);
            return;
        }

        creating = false;
        comment = "";
        suggestions = await Weeks.GetRecentCommentsAsync(taskId);
        focusComment = true;
    }

    private void BackToList()
    {
        chosen = null;
        suggestions = [];
    }

    private void UseSuggestion(string suggestion)
    {
        comment = suggestion;
        focusComment = true;
    }

    private async Task ConfirmAsync()
    {
        if (chosen is null)
            return;
        var text = comment.Trim();
        await CommentChanged.InvokeAsync(text.Length == 0 ? null : text);
        await OnSelected.InvokeAsync(chosen.Id);
    }

    private async Task OnCommentKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ConfirmAsync();
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await CancelAsync();
    }

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && query.Length > 0)
        {
            // Enter in the search box picks the first listed match.
            var first = TaskPickerView.First(Groups());
            if (first is not null)
                await SelectAsync(first.Id);
        }
    }
}
