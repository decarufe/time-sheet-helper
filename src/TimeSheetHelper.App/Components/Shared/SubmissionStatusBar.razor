@* Sticky status bar of the Submit page: counters, steps, week against the objective, verdict, and the two big actions. *@
<section class="@BarClass" aria-labelledby="@titleId">
    <h2 id="@titleId" class="visually-hidden">État de la semaine</h2>

    <div class="summary-line">
        <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@Status.Announcement</p>

        <div class="counters">
            <button type="button" class="chip danger" disabled="@(Status.Blocking == 0)" @onclick="() => OnGoToGap.InvokeAsync(Status.FirstBlockingId)"
                    aria-label="@($"{Status.Blocking} bloquant(s) : aller au premier")">
                <span aria-hidden="true">✕</span> <strong>@Status.Blocking</strong> bloquant@(Status.Blocking > 1 ? "s" : "")
            </button>
            <span class="chip warn"><span aria-hidden="true">!</span> <strong>@Status.ToVerify</strong> à vérifier</span>
            <span class="chip ok"><span aria-hidden="true">✓</span> <strong>@Status.WithoutGap</strong> sans écart</span>
            @if (Status.Ignored > 0)
            {
                <span class="chip info"><span aria-hidden="true">i</span> <strong>@Status.Ignored</strong> ignoré@(Status.Ignored > 1 ? "s" : "") (session)</span>
            }
        </div>

        @if (Status.WeekText.Length > 0)
        {
            <p class="week @LevelClass(Status.WeekLevel)">
                <span aria-hidden="true">@LevelSymbol(Status.WeekLevel)</span> @Status.WeekText
            </p>
        }
    </div>

    <ol class="steps" aria-label="Étapes">
        @foreach (var step in Status.Steps)
        {
            <li class="@LevelClass(step.Level)">
                <span aria-hidden="true">@LevelSymbol(step.Level)</span> <strong>@step.Name</strong> : @step.Text
            </li>
        }
    </ol>

    <p class="verdict @LevelClass(Status.VerdictLevel)"><strong>@Status.Verdict</strong></p>

    @if (ShowActions)
    {
        <div class="bar-actions">
            <button type="button" class="primary" disabled="@Busy" @onclick="() => OnSimulate.InvokeAsync()">
                @(HasSimulation ? "Relancer la simulation" : "Simulation (aucune saisie)")
            </button>
            <button type="button" class="danger" @ref="fillButton" disabled="@(!Status.CanFill || Busy)" aria-describedby="@(Status.FillDisabledReason is null ? null : reasonId)"
                    @onclick="() => OnFill.InvokeAsync()">Saisir dans Forecast…</button>
            @if (Status.FillDisabledReason is { } reason)
            {
                <span id="@reasonId" class="reason">
                    @reason
                    @if (Status.FirstBlockingId is { } firstId && Status.Blocking > 0)
                    {
                        <button type="button" class="link" @onclick="() => OnGoToGap.InvokeAsync(firstId)">Aller au premier écart bloquant</button>
                    }
                </span>
            }
        </div>
    }
</section>

@code {
    private readonly string titleId = $"status-title-{Guid.NewGuid():N}";
    private readonly string reasonId = $"status-reason-{Guid.NewGuid():N}";
    private ElementReference fillButton;

    [Parameter, EditorRequired] public SubmissionStatus Status { get; set; } = default!;

    /// <summary>The draft or the analysis is being refreshed.</summary>
    [Parameter] public bool Updating { get; set; }

    /// <summary>An operation is running: the buttons wait.</summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public bool HasSimulation { get; set; }

    /// <summary>False when the draft is already typed in Forecast (nothing to simulate or fill).</summary>
    [Parameter] public bool ShowActions { get; set; } = true;

    [Parameter] public EventCallback OnSimulate { get; set; }

    [Parameter] public EventCallback OnFill { get; set; }

    [Parameter] public EventCallback<string?> OnGoToGap { get; set; }

    /// <summary>Gives the focus back to the fill button (after its confirmation was closed).</summary>
    public async ValueTask FocusFillAsync()
    {
        try { await fillButton.FocusAsync(); }
        catch (Exception) { /* prerendering or disconnected circuit: focus is a nicety */ }
    }

    private string BarClass => $"status-bar {LevelClass(Status.VerdictLevel)}{(Updating ? " updating" : "")}";

    private static string LevelClass(StatusLevel level) => level switch
    {
        StatusLevel.Ok => "lvl-ok",
        StatusLevel.Warn => "lvl-warn",
        StatusLevel.Danger => "lvl-danger",
        _ => "lvl-idle",
    };

    private static string LevelSymbol(StatusLevel level) => level switch
    {
        StatusLevel.Ok => "✓",
        StatusLevel.Warn => "!",
        StatusLevel.Danger => "✕",
        _ => "·",
    };
}
