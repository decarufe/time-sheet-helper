@using Microsoft.EntityFrameworkCore
@using TimeSheetHelper.Forecast
@using TimeSheetHelper.Storage
@implements IDisposable
@inject ForecastTaskImporter Importer
@inject ForecastTaskCatalog Catalog
@inject IForecastLookup Lookup
@inject ILogger<NewTaskForm> Logger
@inject IDbContextFactory<TimeSheetDbContext> DbFactory

<form class="new-task" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <h3>@(EditTaskId is null ? "Nouvelle tâche" : "Modifier la tâche")</h3>

    <label for="@projectId">Projet</label>
    <SuggestInput @ref="projectBox" Id="@projectId" Label="Suggestions de projets" Placeholder="Nom du projet (suggestions Forecast)"
                  Value="@state.Project" ValueChanged="OnProjectChanged"
                  Search="SearchProjectNamesAsync" OnSelected="OnSuggestionPicked" />

    <label for="@taskId">Tâche</label>
    <SuggestInput Id="@taskId" Label="Suggestions de tâches" Placeholder="Nom de la tâche (suggestions Forecast)"
                  Value="@state.Task" ValueChanged="OnTaskChanged"
                  Search="SearchTaskNamesAsync" OnSelected="OnSuggestionPicked" />

    <div class="numbers">
        <div>
            <label for="@projectCodeId">Numéro de projet <span class="optional">(facultatif)</span></label>
            <SuggestInput Id="@projectCodeId" Label="Projets correspondant au numéro" Placeholder="P1078 ou 1078"
                          Value="@state.ProjectCode" ValueChanged="OnProjectCodeChanged"
                          Search="SearchProjectNumbersAsync" OnSelected="OnSuggestionPicked" OnCommit="OnProjectNumberCommitAsync" />
        </div>
        <div>
            <label for="@taskCodeId">Numéro de tâche <span class="optional">(facultatif)</span></label>
            <SuggestInput Id="@taskCodeId" Label="Tâches correspondant au numéro" Placeholder="T35647 ou 35647"
                          Value="@state.TaskCode" ValueChanged="OnTaskCodeChanged"
                          Search="SearchTaskNumbersAsync" OnSelected="OnSuggestionPicked" OnCommit="OnTaskNumberCommitAsync" />
        </div>
    </div>
    <p class="hint">
        Saisissez un numéro Forecast pour remplir le reste, ou tapez quelques lettres pour obtenir des suggestions.
        Ce que vous avez saisi vous-même n'est jamais remplacé. Sans numéro, la tâche est repérée par « projet / tâche » (temps interne) ;
        un projet déjà connu garde son numéro.
    </p>

    @if (autoFilling)
    {
        <p class="note" role="status"><span class="spinner" aria-hidden="true"></span> Recherche dans Forecast…</p>
    }
    @if (lookupError is not null)
    {
        <p class="note warn" role="status">@lookupError Vous pouvez saisir le projet et la tâche à la main.</p>
    }
    @if (notes.Count > 0)
    {
        <div role="status" aria-label="Précisions sur le remplissage">
            <ul class="notes">
                @foreach (var note in notes)
                {
                    <li>@note</li>
                }
            </ul>
        </div>
    }

    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }

    <div class="buttons">
        <button type="submit" class="primary" disabled="@busy">@(busy ? "Enregistrement…" : SubmitLabel)</button>
        <button type="button" disabled="@busy" @onclick="() => OnCancel.InvokeAsync()">Annuler</button>
    </div>
</form>

@code {
    private readonly string projectId = $"nt-project-{Guid.NewGuid():N}";
    private readonly string taskId = $"nt-task-{Guid.NewGuid():N}";
    private readonly string projectCodeId = $"nt-project-code-{Guid.NewGuid():N}";
    private readonly string taskCodeId = $"nt-task-code-{Guid.NewGuid():N}";
    private readonly TaskFormState state = new();
    private SuggestInput? projectBox;
    private List<string> projects = [];
    private List<string> notes = [];
    private CancellationTokenSource? autoFillCts;
    private Task<bool>? pendingAutoFill;
    private string? lastAutoFillKey;
    private string? failedAutoFillKey;
    private string? lookupError;
    private string? error;
    private bool autoFilling;
    private bool busy;

    /// <summary>Pre-fills the task name (typically what was typed in a search box that found nothing).</summary>
    [Parameter] public string? InitialTaskName { get; set; }

    [Parameter] public string SubmitLabel { get; set; } = "Créer et choisir";

    /// <summary>When set, the form edits this task instead of creating one.</summary>
    [Parameter] public int? EditTaskId { get; set; }

    /// <summary>Raised with the id of the task that was created (or found again and reactivated) or updated.</summary>
    [Parameter] public EventCallback<int> OnCreated { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        state.Task = InitialTaskName?.Trim() ?? "";
        await using var db = await DbFactory.CreateDbContextAsync();
        projects = (await db.ForecastTasks.AsNoTracking().Select(t => t.ProjectName).Distinct().ToListAsync())
            .OrderBy(p => p, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        if (EditTaskId is { } id && await Catalog.FindAsync(id) is { } existing)
        {
            state.Project = existing.ProjectName;
            state.Task = existing.TaskName;
            state.ProjectCode = existing.ProjectCode ?? "";
            state.TaskCode = ForecastCodes.TaskCode.Match(existing.ExternalId) is { Success: true } m && m.Value == existing.ExternalId ? m.Value : "";
            // Saved numbers are not looked up again unless the user edits them.
            lastAutoFillKey = state.BuildAutoFillRequest(AutoFillTrigger.Submit).Key;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && projectBox is not null)
            await projectBox.FocusAsync();
    }

    public void Dispose()
    {
        autoFillCts?.Cancel();
        autoFillCts?.Dispose();
        autoFillCts = null;
    }

    // Suggestions while typing

    private async Task<SuggestionBatch> SearchProjectNamesAsync(string text, CancellationToken token) =>
        ForecastSuggestions.ProjectBatch(await Lookup.SearchProjectsAsync(text, token), projects, text, numberFirst: false);

    private async Task<SuggestionBatch> SearchProjectNumbersAsync(string text, CancellationToken token) =>
        ForecastSuggestions.ProjectBatch(await Lookup.SearchProjectsAsync(text, token), [], text, numberFirst: true);

    private async Task<SuggestionBatch> SearchTaskNamesAsync(string text, CancellationToken token) =>
        ForecastSuggestions.TaskBatch(await Lookup.SearchTasksAsync(text, state.ProjectIdForSearch, token), numberFirst: false);

    private async Task<SuggestionBatch> SearchTaskNumbersAsync(string text, CancellationToken token) =>
        ForecastSuggestions.TaskBatch(await Lookup.SearchTasksAsync(text, state.ProjectIdForSearch, token), numberFirst: true);

    private void OnProjectChanged(string value)
    {
        state.Project = value;
        if (state.OnProjectEdited() is { } note)
            notes = [note];
    }

    private void OnTaskChanged(string value)
    {
        state.Task = value;
        if (state.OnTaskEdited() is { } note)
            notes = [note];
    }

    private void OnProjectCodeChanged(string value) => state.ProjectCode = value;

    private void OnTaskCodeChanged(string value) => state.TaskCode = value;

    /// <summary>A suggestion was picked: the match carries everything needed, no further Forecast call.</summary>
    private void OnSuggestionPicked(SuggestionOption option)
    {
        autoFillCts?.Cancel();
        pendingAutoFill = null;
        autoFilling = false;
        lookupError = null;

        var outcome = new FillOutcome(false, []);
        switch (option.Tag)
        {
            case ForecastProjectMatch project:
                outcome = state.ChooseProject(project);
                break;
            case ForecastTaskMatch forecastTask:
                outcome = state.ChooseTask(forecastTask);
                break;
            case string knownProject:
                state.ChooseKnownProject(knownProject);
                break;
        }

        notes = outcome.Notes.ToList();
        lastAutoFillKey = state.BuildAutoFillRequest(AutoFillTrigger.Submit).Key;
    }

    // Auto-fill from the numbers

    private Task OnProjectNumberCommitAsync(string value)
    {
        state.ProjectCode = TaskFormState.NormalizeProjectNumber(value);
        return pendingAutoFill = AutoFillAsync(AutoFillTrigger.ProjectNumber);
    }

    private Task OnTaskNumberCommitAsync(string value)
    {
        state.TaskCode = TaskFormState.NormalizeTaskNumber(value);
        return pendingAutoFill = AutoFillAsync(AutoFillTrigger.TaskNumber);
    }

    /// <summary>Asks Forecast for the numbers typed and fills the fields (see <see cref="TaskFormState"/> for what may be replaced). True when a field was filled.</summary>
    private async Task<bool> AutoFillAsync(AutoFillTrigger trigger)
    {
        var request = state.BuildAutoFillRequest(trigger);
        if (request.IsEmpty || request.Key == lastAutoFillKey)
            return false;
        if (trigger == AutoFillTrigger.Submit && request.Key == failedAutoFillKey)
            return false;

        autoFillCts?.Cancel();
        autoFillCts?.Dispose();
        var cts = autoFillCts = new CancellationTokenSource();
        autoFilling = true;
        lookupError = null;
        notes = [];
        try
        {
            var result = await ForecastLookupGuard.AutoFillAsync(Lookup, request, Logger, cts.Token);
            if (cts.IsCancellationRequested)
                return false;

            if (!result.Succeeded)
            {
                failedAutoFillKey = request.Key;
                lookupError = result.Error;
                return false;
            }

            failedAutoFillKey = null;
            var outcome = state.ApplyAutoFill(result);
            notes = outcome.Notes.ToList();
            if (outcome.Changed)
                notes.Add("Champs remplis depuis Forecast : vérifiez-les avant d'enregistrer.");
            lastAutoFillKey = state.BuildAutoFillRequest(AutoFillTrigger.Submit).Key;
            return outcome.Changed;
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        finally
        {
            if (autoFillCts == cts)
                autoFilling = false;
        }
    }

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;
        try
        {
            state.NormalizeCodes();

            // Numbers typed but not looked up yet (or being looked up): fill first, and let the user check what appeared before saving.
            var filled = pendingAutoFill is { IsCompleted: false } running ? await running : await AutoFillAsync(AutoFillTrigger.Submit);
            if (filled)
                return;

            if (EditTaskId is { } editId)
            {
                var update = await Catalog.UpdateAsync(editId, state.Project, state.Task, state.ProjectCode, state.TaskCode);
                if (update.Ok)
                    await OnCreated.InvokeAsync(editId);
                else
                    error = update.Error;
                return;
            }

            var result = await Importer.AddAsync(state.Project, state.Task, state.ProjectCode, state.TaskCode);
            if (result.TaskId is { } id)
                await OnCreated.InvokeAsync(id);
            else
                error = result.Error;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
