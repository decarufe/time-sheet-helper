@* Line icon set of the navigation prototype (docs\nav-prototypes\shared\pages.js) + minus, lock, clock, ring (CR-4) + eye, eye-off (tracking). *@
<svg class="ico @(Small ? "sm" : null) @Class" viewBox="0 0 24 24" aria-hidden="true" focusable="false">@((MarkupString)Paths(Name))</svg>

@code {
