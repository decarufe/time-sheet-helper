@page "/taches"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using TimeSheetHelper.App.Components.Shared
@using TimeSheetHelper.Core.Forecast
@using TimeSheetHelper.Forecast
@implements IDisposable
@inject ForecastTaskCatalog Catalog

<PageTitle>Tâches Forecast — Time Sheet Helper</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>Tâches Forecast</h1>
        <p class="muted">
            Les projets et les tâches proposés pour associer votre temps (sélecteur de tâche, règles, saisie dans Forecast).
            Ajoutez, modifiez ou retirez-les ici ; les favoris passent en tête du sélecteur.
        </p>
    </header>

    <section class="card">
        <div class="section-head">
            <h2>Tâches enregistrées</h2>
            <div class="head-actions">
                <span class="muted">@counts.Active active(s) sur @counts.Total · @counts.Favorites favorite(s) · @counts.Excluded exclue(s) de la soumission</span>
                <button class="primary" @onclick="OpenAdd">Ajouter une tâche</button>
            </div>
        </div>

        <div class="filters">
            <label class="visually-hidden" for="task-filter">Rechercher</label>
            <input id="task-filter" type="text" placeholder="Rechercher par projet, client, tâche ou code…"
                   value="@search" @oninput="OnSearchInput" />

            <label>État
                <select @bind="status" @bind:after="RefreshAsync">
                    <option value="@ForecastTaskStatusFilter.Active">Actives</option>
                    <option value="@ForecastTaskStatusFilter.Inactive">Désactivées</option>
                    <option value="@ForecastTaskStatusFilter.All">Toutes</option>
                </select>
            </label>

            <label>Grouper par
                <select @bind="grouping" @bind:after="RefreshAsync">
                    <option value="@ForecastTaskGrouping.None">Aucun</option>
                    <option value="@ForecastTaskGrouping.Project">Projet</option>
                    <option value="@ForecastTaskGrouping.Client">Client</option>
                    <option value="@ForecastTaskGrouping.Status">État</option>
                </select>
            </label>

            <label class="checkbox"><input type="checkbox" @bind="favoritesOnly" @bind:after="RefreshAsync" /> Favoris seulement</label>
            <label class="checkbox"><input type="checkbox" @bind="excludedOnly" @bind:after="RefreshAsync" /> Exclues de la soumission seulement</label>
        </div>

        @if (selected.Count > 0)
        {
            <div class="bulk" role="toolbar" aria-label="Actions sur la sélection">
                <strong>@selected.Count sélectionnée(s)</strong>
                <button disabled="@busy" @onclick="() => SetActiveAsync(true)">Activer</button>
                <button disabled="@busy" @onclick="() => SetActiveAsync(false)">Désactiver</button>
                <button disabled="@busy" @onclick="() => SetFavoriteAsync(true)">★ Ajouter aux favoris</button>
                <button disabled="@busy" @onclick="() => SetFavoriteAsync(false)">☆ Retirer des favoris</button>
                <button disabled="@busy" @onclick="() => SetExcludeAsync(true)">Exclure de la soumission</button>
                <button disabled="@busy" @onclick="() => SetExcludeAsync(false)">Inclure dans la soumission</button>
                <button class="danger" disabled="@busy" @onclick="() => AskDelete(selected.ToList())">Supprimer</button>
                <button class="link" @onclick="ClearSelection">Tout désélectionner</button>
            </div>
        }

        @if (error is not null)
        {
            <div class="alert error" role="alert">@error</div>
        }
        else if (message is not null)
        {
            <p class="ok-text" role="status">@message</p>
        }
        @if (blocked.Count > 0)
        {
            <div class="alert warn" role="status">
                <p>Conservée(s) car utilisée(s) par des règles ou des feuilles de temps :</p>
                <ul>
                    @foreach (var item in blocked)
                    {
                        <li>@item.Name <span class="muted">(@item.References utilisation(s))</span></li>
                    }
                </ul>
                <button disabled="@busy" @onclick="DeactivateBlockedAsync">Les désactiver plutôt</button>
            </div>
        }

        <p class="muted result-count" aria-live="polite">@total résultat(s)</p>

        <div class="table-wrap">
            <table class="tasks">
                <thead>
                    <tr>
                        <th class="select-col">
                            <input type="checkbox" aria-label="Tout sélectionner" checked="@(total > 0 && selected.Count == total)"
                                   disabled="@(total == 0)" @onchange="e => ToggleAllAsync((bool)e.Value!)" />
                        </th>
                        <th class="star-col"><span class="visually-hidden">Favori</span></th>
                        <th><button class="sort" @onclick="() => SetSortAsync(ForecastTaskSort.Project)">Projet@(SortMark(ForecastTaskSort.Project))</button></th>
                        <th><button class="sort" @onclick="() => SetSortAsync(ForecastTaskSort.Task)">Tâche@(SortMark(ForecastTaskSort.Task))</button></th>
                        <th><button class="sort" @onclick="() => SetSortAsync(ForecastTaskSort.LastSeen)">Vue le@(SortMark(ForecastTaskSort.LastSeen))</button></th>
                        <th class="actions-col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize @ref="grid" TItem="ForecastTaskRow" ItemsProvider="LoadRowsAsync" ItemSize="37" OverscanCount="15" SpacerElement="tr">
                        <ItemContent Context="row">
                            @if (row.GroupHeader is not null)
                            {
                                <tr class="group"><th colspan="6">@row.GroupHeader</th></tr>
                            }
                            <tr class="@(row.Task.IsActive ? null : "disabled")">
                                <td class="select-col">
                                    <input type="checkbox" aria-label="Sélectionner @row.Task.TaskName"
                                           checked="@selected.Contains(row.Task.Id)"
                                           @onchange="e => ToggleSelect(row.Task.Id, (bool)e.Value!)" />
                                </td>
                                <td class="star-col">
                                    <button class="star @(row.Task.IsFavorite ? "on" : null)" disabled="@busy"
                                            aria-pressed="@row.Task.IsFavorite"
                                            title="@(row.Task.IsFavorite ? "Retirer des favoris" : "Ajouter aux favoris")"
                                            @onclick="() => ToggleFavoriteAsync(row.Task)">@(row.Task.IsFavorite ? "★" : "☆")</button>
                                </td>
                                <td>@if (row.Task.ProjectCode is { } pc) { <code>@pc</code> } @row.Task.ProjectName</td>
                                <td>@if (IsTaskCode(row.Task.ExternalId)) { <code>@row.Task.ExternalId</code> } @row.Task.TaskName@if (row.Task.ExcludeFromSubmission) { <span class="badge excluded"> Exclue de la soumission</span> }</td>
                                <td class="nowrap muted">@(row.Task.LastSeenUtc.ToLocalTime().ToString("yyyy-MM-dd"))</td>
                                <td class="actions">
                                    <button disabled="@busy" aria-pressed="@row.Task.ExcludeFromSubmission"
                                            title="Les heures de cette tâche ne sont pas envoyées dans Forecast à la soumission"
                                            @onclick="() => ToggleExcludeAsync(row.Task)">@(row.Task.ExcludeFromSubmission ? "Inclure dans la soumission" : "Exclure de la soumission")</button>
                                    <button disabled="@busy" @onclick="() => OpenEdit(row.Task.Id)">Modifier</button>
                                    <button disabled="@busy" @onclick="() => ToggleActiveAsync(row.Task)">@(row.Task.IsActive ? "Désactiver" : "Réactiver")</button>
                                    <button class="danger" disabled="@busy" @onclick="() => AskDelete([row.Task.Id])">Supprimer</button>
                                </td>
                            </tr>
                        </ItemContent>
                        <Placeholder>
                            <tr class="placeholder"><td colspan="6" class="muted">Chargement…</td></tr>
                        </Placeholder>
                    </Virtualize>
                </tbody>
            </table>
        </div>
        @if (total == 0)
        {
            <p class="empty muted">Aucune tâche à afficher.</p>
        }
    </section>
</div>

@if (dialog == Dialog.Form)
{
    <div class="backdrop" @onclick="CloseDialog">
        <div class="dialog" role="dialog" aria-modal="true" @onclick:stopPropagation>
            <NewTaskForm EditTaskId="editId" SubmitLabel="@(editId is null ? "Ajouter" : "Enregistrer")"
                         OnCreated="OnSaved" OnCancel="CloseDialog" />
        </div>
    </div>
}
else if (dialog == Dialog.ConfirmDelete)
{
    <div class="backdrop" @onclick="CloseDialog">
        <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="delete-title" @onclick:stopPropagation>
            <h3 id="delete-title">Supprimer @(deleteIds.Count == 1 ? "cette tâche" : $"ces {deleteIds.Count} tâches") ?</h3>
            <p class="hint">
                La suppression est définitive. Une tâche utilisée par une règle ou une feuille de temps est conservée :
                vous pourrez alors la désactiver à la place.
            </p>
            <div class="buttons">
                <button class="danger" disabled="@busy" @onclick="ConfirmDeleteAsync">@(busy ? "Suppression…" : "Supprimer")</button>
                <button disabled="@busy" @onclick="CloseDialog">Annuler</button>
            </div>
        </div>
    </div>
}

@code {
    private enum Dialog { None, Form, ConfirmDelete }

    private Virtualize<ForecastTaskRow>? grid;
    private CancellationTokenSource? searchDebounce;
    private readonly HashSet<int> selected = [];
    private List<ForecastTaskBlocked> blocked = [];
    private List<int> deleteIds = [];
    private ForecastTaskCounts counts = new(0, 0, 0);
    private Dialog dialog;
    private int? editId;
    private int total;
    private bool busy;
    private string? message;
    private string? error;

    private string search = "";
    private ForecastTaskStatusFilter status = ForecastTaskStatusFilter.Active;
    private ForecastTaskGrouping grouping = ForecastTaskGrouping.None;
    private bool favoritesOnly;
    private bool excludedOnly;
    private ForecastTaskSort sort = ForecastTaskSort.Project;
    private bool descending;

    private ForecastTaskQuery Query => new(search, status, favoritesOnly, sort, descending, grouping, excludedOnly);

    protected override async Task OnInitializedAsync()
    {
        counts = await Catalog.CountsAsync();
        total = (await Catalog.QueryAsync(Query, 0, 0)).Total;
    }

    public void Dispose() => searchDebounce?.Cancel();

    private async ValueTask<ItemsProviderResult<ForecastTaskRow>> LoadRowsAsync(ItemsProviderRequest request)
    {
        var page = await Catalog.QueryAsync(Query, request.StartIndex, request.Count, request.CancellationToken);
        return new ItemsProviderResult<ForecastTaskRow>(page.Items, page.Total);
    }

    private async Task RefreshAsync() => await ReloadAsync(clearSelection: true);

    private async Task ReloadAsync(bool clearSelection)
    {
        if (clearSelection)
            selected.Clear();
        counts = await Catalog.CountsAsync();
        total = (await Catalog.QueryAsync(Query, 0, 0)).Total;
        if (grid is not null)
            await grid.RefreshDataAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";
        searchDebounce?.Cancel();
        var cts = searchDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await RefreshAsync();
    }

    private async Task SetSortAsync(ForecastTaskSort column)
    {
        descending = sort == column && !descending;
        sort = column;
        await RefreshAsync();
    }

    private string SortMark(ForecastTaskSort column) => sort != column ? "" : descending ? " ▼" : " ▲";

    private static bool IsTaskCode(string externalId) =>
        ForecastCodes.TaskCode.Match(externalId) is { Success: true } m && m.Value == externalId;

    private void ToggleSelect(int id, bool on)
    {
        if (on)
            selected.Add(id);
        else
            selected.Remove(id);
    }

    private async Task ToggleAllAsync(bool on)
    {
        selected.Clear();
        if (on)
            foreach (var id in await Catalog.QueryIdsAsync(Query))
                selected.Add(id);
        if (grid is not null)
            await grid.RefreshDataAsync();
    }

    private async Task ClearSelection()
    {
        selected.Clear();
        if (grid is not null)
            await grid.RefreshDataAsync();
    }

    private void OpenAdd()
    {
        editId = null;
        dialog = Dialog.Form;
    }

    private void OpenEdit(int id)
    {
        editId = id;
        dialog = Dialog.Form;
    }

    private void CloseDialog()
    {
        if (!busy)
            dialog = Dialog.None;
    }

    private async Task OnSaved(int id)
    {
        message = editId is null ? "Tâche ajoutée." : "Tâche modifiée.";
        error = null;
        blocked = [];
        dialog = Dialog.None;
        await ReloadAsync(clearSelection: false);
    }

    private void AskDelete(List<int> ids)
    {
        if (ids.Count == 0)
            return;
        deleteIds = ids;
        dialog = Dialog.ConfirmDelete;
    }

    private async Task ConfirmDeleteAsync() => await RunAsync(async () =>
    {
        var report = await Catalog.DeleteAsync(deleteIds);
        selected.ExceptWith(deleteIds);
        blocked = report.Blocked.ToList();
        message = report.Summary;
        dialog = Dialog.None;
    });

    private async Task DeactivateBlockedAsync() => await RunAsync(async () =>
    {
        var changed = await Catalog.SetActiveAsync(blocked.Select(b => b.TaskId).ToList(), false);
        message = $"{changed} tâche(s) désactivée(s).";
        blocked = [];
    });

    private async Task SetActiveAsync(bool active) => await RunAsync(async () =>
    {
        var changed = await Catalog.SetActiveAsync(selected.ToList(), active);
        message = active ? $"{changed} tâche(s) activée(s)." : $"{changed} tâche(s) désactivée(s).";
    });

    private async Task SetFavoriteAsync(bool favorite) => await RunAsync(async () =>
    {
        var changed = await Catalog.SetFavoriteAsync(selected.ToList(), favorite);
        message = favorite ? $"{changed} tâche(s) ajoutée(s) aux favoris." : $"{changed} tâche(s) retirée(s) des favoris.";
    });

    private async Task ToggleFavoriteAsync(ForecastTask task) => await RunAsync(async () =>
    {
        await Catalog.SetFavoriteAsync([task.Id], !task.IsFavorite);
        message = null;
    });

    private async Task SetExcludeAsync(bool exclude) => await RunAsync(async () =>
    {
        var changed = await Catalog.SetExcludeFromSubmissionAsync(selected.ToList(), exclude);
        message = exclude ? $"{changed} tâche(s) exclue(s) de la soumission." : $"{changed} tâche(s) incluse(s) dans la soumission.";
    });

    private async Task ToggleExcludeAsync(ForecastTask task) => await RunAsync(async () =>
    {
        await Catalog.SetExcludeFromSubmissionAsync([task.Id], !task.ExcludeFromSubmission);
        message = null;
    });

    private async Task ToggleActiveAsync(ForecastTask task) => await RunAsync(async () =>
    {
        await Catalog.SetActiveAsync([task.Id], !task.IsActive);
        message = null;
    });

    /// <summary>Runs a change, then reloads the list; the selection survives (only deletions prune it).</summary>
    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        error = null;
        try
        {
            await action();
            await ReloadAsync(clearSelection: false);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
