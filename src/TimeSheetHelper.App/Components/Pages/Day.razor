@page "/jour"
@page "/jour/{Date}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using TimeSheetHelper.App.Components.Shared
@using TimeSheetHelper.Core.Activities
@using TimeSheetHelper.Engine
@using TimeSheetHelper.Engine.Allocation
@using TimeSheetHelper.Engine.Learning
@using TimeSheetHelper.Engine.Proposals
@using TimeSheetHelper.Storage
@inject WeekService Weeks
@inject SlotAllocator Allocator
@inject IOptions<EngineOptions> EngineOptionsAccessor
@inject IDbContextFactory<TimeSheetDbContext> DbFactory
@inject NavigationManager Nav
@inject ILogger<Day> Logger

<PageTitle>Jour — Time Sheet Helper</PageTitle>

<div class="day @(selection is null ? null : "has-selection")">
    <header class="toolbar">
        <nav class="day-nav" aria-label="Navigation par jour">
            <button type="button" @onclick="() => GoTo(day.AddDays(-1))" aria-label="Jour précédent">‹</button>
            <button type="button" @onclick="() => GoTo(Today)" disabled="@(day == Today)">Aujourd'hui</button>
            <button type="button" @onclick="() => GoTo(day.AddDays(1))" aria-label="Jour suivant">›</button>
            <DatePickerButton Value="day" Label="Choisir un jour dans le calendrier" OnPicked="GoTo" />
        </nav>
        <h1>@TimesheetUi.Capitalize(day.ToString("dddd d MMMM yyyy", TimesheetUi.French))</h1>
        <span class="spacer"></span>
        <a class="button" href="@WeekHref">Voir la semaine</a>
    </header>

    @if (message is not null)
    {
        <div class="notice @(messageIsError ? "error" : "info")" role="status">
            <span>@message</span>
            @if (lastCorrection is { } correction && !messageIsError && !IsSubmitted)
            {
                <button type="button" class="link-action" @onclick="() => PreviewRuleAsync(correction.Target, correction.TaskId)" disabled="@busy">
                    Créer une règle à partir de cette correction
                </button>
            }
            <button type="button" class="dismiss" @onclick="ClearMessage" aria-label="Masquer le message">✕</button>
        </div>
    }

    @if (timeline is null)
    {
        <p class="muted">@(loadError ?? "Chargement de la journée…")</p>
    }
    else
    {
        @if (IsSubmitted)
        {
            <p class="notice submitted">La feuille de temps de cette semaine a été soumise : la journée est affichée en lecture seule.</p>
        }

        <section class="summary" aria-label="Résumé de la journée">
            <div class="totals @FlagClass">
                <span class="big">@TimesheetUi.Hours(TotalHours) h</span>
                <span class="muted">sur @TimesheetUi.Hours(TargetHours) h visées</span>
                @if (TotalHours < TargetHours)
                {
                    <span class="gap">il manque @TimesheetUi.Hours(TargetHours - TotalHours) h</span>
                }
                else if (TotalHours > TargetHours)
                {
                    <span class="gap">@TimesheetUi.Hours(TotalHours - TargetHours) h de plus que l'objectif</span>
                }
            </div>
            <ul class="task-hours">
                @foreach (var (taskId, hours) in taskHours)
                {
                    <li style="@TimesheetUi.TaskStyle(taskId)">
                        <span class="swatch" aria-hidden="true"></span>
                        <span class="name">@TaskName(taskId)</span>
                        <span class="hours">@TimesheetUi.Hours(hours) h</span>
                        @if (TaskNotes(taskId) is { } notes)
                        {
                            <span class="task-note">@notes</span>
                        }
                    </li>
                }
                @if (unclassifiedHours > 0)
                {
                    <li class="unclassified">
                        <span class="swatch" aria-hidden="true"></span>
                        <span class="name">Non classé</span>
                        <span class="hours">@TimesheetUi.Hours(unclassifiedHours) h</span>
                    </li>
                }
                @if (taskHours.Count == 0 && unclassifiedHours == 0)
                {
                    <li class="muted">Aucune activité de travail détectée ce jour-là.</li>
                }
            </ul>
            @if (timeline.Tasks.Values.All(t => t.IsIgnored))
            {
                <p class="muted">Aucune tâche Forecast : synchronisez-les depuis la page <a href="sources">Sources</a>.</p>
            }
        </section>

        <div class="timeline-head">
            <h2>Créneaux de 15 minutes</h2>
            <label class="toggle">
                <input type="checkbox" @bind="showWholeDay" @bind:after="ComputeVisible" />
                Toute la journée
            </label>
        </div>
        @if (!IsSubmitted)
        {
            <p class="hint muted">Cliquez sur un créneau pour le sélectionner, Maj+clic pour étendre la sélection, Ctrl+clic pour ajouter ou retirer des créneaux non consécutifs (Maj+↑/↓ au clavier, Échap pour annuler).</p>
        }

        <ol class="timeline" aria-label="Créneaux de la journée">
            @for (var i = 0; i < visible.Count; i++)
            {
                var index = i;
                var row = visible[i];
                var slot = row.Slot;
                var selected = IsSelected(index);
                var expandedRow = expanded.Contains(slot.SlotStartUtc);
                var removedRow = TimesheetUi.IsRemoved(slot);
                <li class="slot @KindClass(slot) @(row.Local.Minute == 0 ? "hour-start" : null) @(selected ? "selected" : null) @(removedRow ? "removed" : null)"
                    style="@(slot.TaskId is { } tid && slot.Kind != SlotKind.Ignored ? TimesheetUi.TaskStyle(tid) : null)">
                    <div class="slot-line">
                        <button type="button" class="slot-main" aria-pressed="@(selected ? "true" : "false")"
                                title="@SlotTitle(row)" disabled="@IsSubmitted"
                                @onclick="e => OnSlotClick(index, e)" @onkeydown="e => OnSlotKeyDown(index, e)">
                            <span class="time">@row.Local.ToString("HH:mm")</span>
                            <span class="band" aria-hidden="true"></span>
                            <span class="label">@SlotLabel(slot)</span>
                            @if (!string.IsNullOrEmpty(slot.Notes))
                            {
                                <span class="note" title="@slot.Notes">« @slot.Notes »</span>
                            }
                            @if (slot.Kind is not (SlotKind.Empty or SlotKind.ExcludedByOverride or SlotKind.Ignored or SlotKind.Removed))
                            {
                                <span class="kind-badge">@TimesheetUi.SlotKindLabel(slot.Kind)</span>
                            }
                            @if (slot.IsWork && slot.Kind != SlotKind.Override)
                            {
                                <span class="conf @TimesheetUi.ConfidenceClass(slot.Confidence)">@TimesheetUi.Percent(slot.Confidence)</span>
                            }
                        </button>
                        @if (slot.Evidence.Count > 0)
                        {
                            <button type="button" class="expand" aria-expanded="@(expandedRow ? "true" : "false")"
                                    aria-label="@(expandedRow ? "Masquer" : "Afficher") les preuves de @row.Local.ToString("HH:mm")"
                                    @onclick="() => ToggleExpanded(slot.SlotStartUtc)">
                                <span aria-hidden="true">@(expandedRow ? "▾" : "▸")</span> @slot.Evidence.Count
                            </button>
                        }
                        @if (!IsSubmitted && !removedRow)
                        {
                            <button type="button" class="remove" disabled="@busy"
                                    title="Supprimer ce créneau et ses activités (définitif, avec confirmation)"
                                    aria-label="Supprimer le créneau de @row.Local.ToString("HH:mm") et ses activités"
                                    @onclick="() => AskRemove(row)">
                                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                                    <path fill="currentColor" d="M6.5 1h3l.5 1H14v1.5H2V2h4zM3.5 5h9l-.6 9.1a1 1 0 0 1-1 .9H5.1a1 1 0 0 1-1-.9z" />
                                </svg>
                            </button>
                        }
                    </div>
                    @if (expandedRow)
                    {
                        <div class="evidence">
                            @if (slot.Alternatives.Count > 0)
                            {
                                <p class="alternatives">
                                    Autres candidats :
                                    @string.Join(" · ", slot.Alternatives.Select(a => $"{CandidateLabel(a)} ({TimesheetUi.Percent(a.Share)})"))
                                </p>
                            }
                            <ul>
                                @foreach (var activity in Evidence(slot))
                                {
                                    <li>
                                        <span class="ev-time">@ActivityTime(activity)</span>
                                        <span class="ev-source">@TimesheetUi.SourceLabel(activity.Source)@(activity.Kind is { Length: > 0 } k ? $" · {k}" : "")</span>
                                        <span class="ev-body">
                                            @if (!string.IsNullOrWhiteSpace(activity.ProcessName))
                                            {
                                                <span class="ev-app">@activity.ProcessName</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(activity.Title))
                                            {
                                                <span class="ev-title">@activity.Title</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(activity.Subject) && activity.Subject != activity.Title)
                                            {
                                                <span class="ev-title">« @activity.Subject »</span>
                                            }
                                            @if ((activity.FilePath ?? activity.Folder) is { Length: > 0 } where)
                                            {
                                                <code>@where</code>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(activity.Repo))
                                            {
                                                <span class="ev-repo">dépôt @activity.Repo</span>
                                            }
                                        </span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </li>
            }
        </ol>
    }

    @if (pendingRule is { } pending)
    {
        <div class="action-bar confirm" role="alertdialog" aria-label="Confirmer la règle">
            <span>Toujours associer <strong>« @pending.Proposal.Name »</strong> à <strong>@TaskName(pending.TaskId)</strong> ?</span>
            <span class="spacer"></span>
            <button type="button" class="primary" @onclick="ConfirmRuleAsync" disabled="@busy">Confirmer</button>
            <button type="button" @onclick="() => pendingRule = null" disabled="@busy">Annuler</button>
        </div>
    }
    else if (selection is { } sel && !IsSubmitted && timeline is not null)
    {
        <div class="action-bar" role="toolbar" aria-label="Actions sur la sélection">
            <span class="selection-info">
                <strong>@SelectionSpans()</strong>
                <span class="muted">@sel.Indices.Count @(sel.Indices.Count > 1 ? "créneaux" : "créneau") · @TimesheetUi.Hours(sel.Indices.Count * 0.25m) h</span>
            </span>
            <span class="spacer"></span>
            <button type="button" class="primary" @onclick="() => picker = PickerMode.Assign" disabled="@busy">Assigner à…</button>
            <button type="button" class="not-work" @onclick="() => AssignAsync(null)" disabled="@busy"
                    title="Garde les activités et les infos des créneaux, mais ne les compte pas dans la feuille de temps. Les créneaux restent réassignables plus tard.">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1.5a5.5 5.5 0 0 1 4.2 9.04L4.46 3.8A5.5 5.5 0 0 1 8 2.5zm0 11a5.5 5.5 0 0 1-4.2-9.04l7.74 7.74A5.5 5.5 0 0 1 8 13.5z" />
                </svg>
                Pas du travail
            </button>
            <button type="button" @onclick="ClearOverridesAsync" disabled="@(busy || !SelectionHasOverride)">Annuler l'assignation manuelle</button>
            <button type="button" @onclick="() => picker = PickerMode.Rule" disabled="@(busy || !SelectionIsContiguous)"
                    title="@(SelectionIsContiguous ? null : "Sélectionnez des créneaux consécutifs pour créer une règle.")">Créer une règle à partir de cette correction</button>
            <button type="button" class="delete" @onclick="AskRemoveSelection" disabled="@(busy || RemovableSelection().Count == 0)"
                    title="Supprimer les créneaux sélectionnés et leurs activités (définitif, avec confirmation)"
                    aria-label="@RemoveSelectionLabel()">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M6.5 1h3l.5 1H14v1.5H2V2h4zM3.5 5h9l-.6 9.1a1 1 0 0 1-1 .9H5.1a1 1 0 0 1-1-.9z" />
                </svg>
                Supprimer
            </button>
            <button type="button" class="ghost" @onclick="ClearSelection" aria-label="Désélectionner">✕</button>
        </div>
    }
</div>

@if (pendingRemoval is { } removal)
{
    <ConfirmDialog Title="@TimesheetUi.RemoveConfirmationTitle(removal.Starts.Count)"
                   Subtitle="@removal.Description"
                   Message="@TimesheetUi.RemoveConfirmationMessage(removal.Starts.Count)"
                   ConfirmLabel="Supprimer définitivement"
                   OnConfirm="ConfirmRemoveAsync"
                   OnCancel="() => pendingRemoval = null" />
}

@if (picker != PickerMode.None && selection is not null)
{
    <TaskPicker Title="@(picker == PickerMode.Assign ? "Assigner les créneaux à…" : "Créer une règle vers…")"
                Subtitle="@SelectionDescription()"
                SelectedTaskId="@SelectionTaskId()"
                AllowComment="@(picker == PickerMode.Assign)"
                @bind-Comment="assignComment"
                OnSelected="OnTaskPickedAsync"
                OnCancel="() => picker = PickerMode.None" />
}

@code {
    private enum PickerMode { None, Assign, Rule }

    private sealed record VisibleSlot(SlotAssignment Slot, DateTime Local);

    private sealed record Selection(int Anchor, int Edge, IReadOnlySet<int> Indices)
    {
        public int Min => Indices.Min();

        public int Max => Indices.Max();

        public static Selection Span(int anchor, int edge) =>
            new(anchor, edge, Enumerable.Range(Math.Min(anchor, edge), Math.Abs(anchor - edge) + 1).ToHashSet());
    }

    private sealed record PendingRule(CorrectionTarget Target, int TaskId, RuleProposal Proposal);

    private sealed record Correction(CorrectionTarget Target, int TaskId);

    private sealed record PendingRemoval(IReadOnlyList<DateTime> Starts, string Description);

    [Parameter] public string? Date { get; set; }

    private DateOnly day = DateOnly.FromDateTime(DateTime.Today);
    private DayTimeline? timeline;
    private List<VisibleSlot> visible = [];
    private List<(int TaskId, decimal Hours)> taskHours = [];
    private decimal unclassifiedHours;
    private readonly HashSet<DateTime> expanded = [];
    private bool showWholeDay;
    private bool submitted;
    private string? loadError;
    private string? message;
    private bool messageIsError;
    private bool busy;
    private Selection? selection;
    private PickerMode picker;
    private string? assignComment;
    private PendingRule? pendingRule;
    private PendingRemoval? pendingRemoval;
    private Correction? lastCorrection;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private bool IsSubmitted => submitted;

    private string WeekHref => TimesheetUi.WeekStartOf(day) == TimesheetUi.WeekStartOf(Today)
        ? "./"
        : $"./?semaine={TimesheetUi.IsoDate(TimesheetUi.WeekStartOf(day))}";

    private decimal TotalHours => taskHours.Sum(t => t.Hours);

    private string? TaskNotes(int taskId)
    {
        var notes = timeline?.Slots
            .Where(s => s.TaskId == taskId && !string.IsNullOrWhiteSpace(s.Notes))
            .Select(s => s.Notes!)
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        return notes is { Count: > 0 } ? string.Join(" ; ", notes) : null;
    }

    private decimal TargetHours => day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? 0m : EngineOptionsAccessor.Value.TargetHoursPerDay;

    private string FlagClass => TotalHours < TargetHours ? "under" : TotalHours > TargetHours ? "over" : "ok";

    private bool SelectionHasOverride => SelectedSlots().Any(s => s.Kind is SlotKind.Override or SlotKind.ExcludedByOverride or SlotKind.Ignored);

    protected override async Task OnParametersSetAsync()
    {
        var requested = TimesheetUi.TryParseIsoDate(Date, out var parsed) ? parsed : Today;
        if (timeline is not null && requested == day)
            return;

        day = requested;
        selection = null;
        picker = PickerMode.None;
        pendingRule = null;
        pendingRemoval = null;
        lastCorrection = null;
        message = null;
        expanded.Clear();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            loadError = null;
            var loaded = await Weeks.GetDayTimelineAsync(day);

            var weekStart = TimesheetUi.WeekStartOf(day);
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                submitted = await db.TimesheetDrafts.AsNoTracking()
                    .AnyAsync(d => d.WeekStart == weekStart && d.SubmittedUtc != null);
            }

            taskHours = loaded.Slots
                .Where(s => s.IsClassified)
                .GroupBy(s => s.TaskId!.Value)
                .Select(g => (g.Key, g.Count() * 0.25m))
                .OrderByDescending(t => t.Item2)
                .ToList();
            unclassifiedHours = loaded.Slots.Count(s => s.IsWork && s.TaskId is null) * 0.25m;
            timeline = loaded;
            ComputeVisible();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading day {Day} failed", day);
            timeline = null;
            visible = [];
            loadError = $"Impossible de charger la journée : {ex.Message}";
        }
    }

    /// <summary>Slots from the first to the last activity, one hour of margin, at least 8:00 to 17:00.</summary>
    private void ComputeVisible()
    {
        if (timeline is null)
            return;

        var tz = Allocator.TimeZone;
        var all = timeline.Slots
            .Select(s => new VisibleSlot(s, TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(s.SlotStartUtc, DateTimeKind.Utc), tz)))
            .ToList();

        // Keep the selection on the same slots when the visible span changes.
        var kept = selection is { } sel && sel.Indices.Append(sel.Anchor).Append(sel.Edge).Max() < visible.Count
            ? (Starts: sel.Indices.Order().Select(i => visible[i].Slot.SlotStartUtc).ToList(),
               Anchor: visible[sel.Anchor].Slot.SlotStartUtc,
               Edge: visible[sel.Edge].Slot.SlotStartUtc)
            : default((List<DateTime> Starts, DateTime Anchor, DateTime Edge)?);

        if (showWholeDay)
        {
            visible = all;
        }
        else
        {
            var midnight = day.ToDateTime(TimeOnly.MinValue);
            var from = midnight.AddHours(8);
            var to = midnight.AddHours(17);
            var active = all.Where(v => !TimesheetUi.IsRemoved(v.Slot) && (v.Slot.Kind != SlotKind.Empty || v.Slot.Evidence.Count > 0)).ToList();
            if (active.Count > 0)
            {
                var first = active[0].Local.AddHours(-1);
                var last = active[^1].Local.AddMinutes(15).AddHours(1);
                from = Min(from, new DateTime(first.Year, first.Month, first.Day, first.Hour, 0, 0));
                var lastHour = new DateTime(last.Year, last.Month, last.Day, last.Hour, 0, 0);
                to = Max(to, last == lastHour ? last : lastHour.AddHours(1));
            }
            visible = all.Where(v => v.Local >= from && v.Local < to && !TimesheetUi.IsRemoved(v.Slot)).ToList();
        }

        selection = null;
        if (kept is { } keep)
        {
            var indices = keep.Starts
                .Select(start => visible.FindIndex(v => v.Slot.SlotStartUtc == start))
                .Where(i => i >= 0)
                .ToHashSet();
            if (indices.Count > 0)
            {
                var anchor = visible.FindIndex(v => v.Slot.SlotStartUtc == keep.Anchor);
                var edge = visible.FindIndex(v => v.Slot.SlotStartUtc == keep.Edge);
                selection = new Selection(anchor >= 0 ? anchor : indices.Min(), edge >= 0 ? edge : indices.Max(), indices);
            }
        }
    }

    private static DateTime Min(DateTime a, DateTime b) => a < b ? a : b;

    private static DateTime Max(DateTime a, DateTime b) => a > b ? a : b;

    private void GoTo(DateOnly target) => Nav.NavigateTo($"jour/{TimesheetUi.IsoDate(target)}");

    // Selection

    private bool IsSelected(int index) => selection is { } s && s.Indices.Contains(index);

    private void OnSlotClick(int index, MouseEventArgs e)
    {
        pendingRule = null;
        if (e.ShiftKey && selection is { } current)
        {
            selection = Selection.Span(current.Anchor, index);
        }
        else if ((e.CtrlKey || e.MetaKey) && selection is { } multi)
        {
            var indices = multi.Indices.ToHashSet();
            if (!indices.Remove(index))
                indices.Add(index);
            selection = indices.Count == 0 ? null : new Selection(index, index, indices);
        }
        else if (selection is { Indices.Count: 1 } single && single.Indices.Contains(index))
        {
            selection = null;
        }
        else
        {
            selection = Selection.Span(index, index);
        }
    }

    private void OnSlotKeyDown(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ClearSelection();
            return;
        }
        if (!e.ShiftKey || e.Key is not ("ArrowDown" or "ArrowUp"))
            return;

        var current = selection ?? Selection.Span(index, index);
        var edge = Math.Clamp(current.Edge + (e.Key == "ArrowDown" ? 1 : -1), 0, visible.Count - 1);
        selection = Selection.Span(current.Anchor, edge);
    }

    private void ClearSelection()
    {
        selection = null;
        picker = PickerMode.None;
    }

    private IEnumerable<SlotAssignment> SelectedSlots() =>
        selection is { } s ? s.Indices.Order().Select(i => visible[i].Slot) : [];

    private List<DateTime> SelectedStarts() => SelectedSlots().Select(s => s.SlotStartUtc).ToList();

    /// <summary>The selected range when the selection has no gap in time: rules are learned from contiguous ranges only.</summary>
    private SlotRange? SelectedRange() =>
        selection is { } s && SelectionIsContiguous ? new SlotRange(visible[s.Min].Slot.SlotStartUtc, visible[s.Max].Slot.SlotEndUtc) : null;

    /// <summary>Hidden (removed) slots can sit between two selected rows, so contiguity is checked on time, not on row index.</summary>
    private bool SelectionIsContiguous => selection is not null && TimesheetUi.AreConsecutive(SelectedStarts());

    /// <summary>Time spans of the selection, one per run of consecutive slots ("09:00 – 09:30, 10:15 – 10:30").</summary>
    private string SelectionSpans() => selection is { } s ? Spans(s.Indices) : "";

    private string Spans(IEnumerable<int> indices)
    {
        var spans = new List<string>();
        var ordered = indices.Order().ToList();
        for (var i = 0; i < ordered.Count;)
        {
            var j = i;
            while (j + 1 < ordered.Count && TimesheetUi.AreAdjacent(visible[ordered[j]].Slot.SlotStartUtc, visible[ordered[j + 1]].Slot.SlotStartUtc))
                j++;
            spans.Add($"{visible[ordered[i]].Local:HH:mm} – {visible[ordered[j]].Local.AddMinutes(15):HH:mm}");
            i = j + 1;
        }
        return string.Join(", ", spans);
    }

    /// <summary>The group key shared by every work slot of the selection, if any: the correction then targets that group only.</summary>
    private string? SelectionGroupKey()
    {
        var work = SelectedSlots().Where(s => s.IsWork).ToList();
        if (work.Count == 0 || work.Any(s => s.GroupKey is null))
            return null;
        var keys = work.Select(s => s.GroupKey).Distinct().ToList();
        return keys.Count == 1 ? keys[0] : null;
    }

    private int? SelectionTaskId()
    {
        var ids = SelectedSlots().Where(s => s.TaskId is not null).Select(s => s.TaskId).Distinct().ToList();
        return ids.Count == 1 ? ids[0] : null;
    }

    private string SelectionDescription()
    {
        if (selection is not { } s)
            return "";
        var text = $"{SelectionSpans()} ({TimesheetUi.Hours(s.Indices.Count * 0.25m)} h)";
        return SelectionGroupKey() is { } key ? $"{text} · {TimesheetUi.GroupLabel(key)}" : text;
    }

    // Actions

    private async Task OnTaskPickedAsync(int taskId)
    {
        var mode = picker;
        picker = PickerMode.None;
        if (mode == PickerMode.Assign)
        {
            var notes = assignComment;
            assignComment = null;
            await AssignAsync(taskId, notes);
        }
        else if (mode == PickerMode.Rule && SelectedRange() is { } range)
            await PreviewRuleAsync(new CorrectionTarget(range, SelectionGroupKey()), taskId);
    }

    private async Task AssignAsync(int? taskId, string? notes = null)
    {
        var starts = SelectedStarts();
        if (starts.Count == 0)
            return;
        var target = SelectedRange() is { } range ? new CorrectionTarget(range, SelectionGroupKey()) : null;

        await RunAsync(async () =>
        {
            await Weeks.AssignSlotStartsAsync(starts, taskId, notes);
            selection = null;
            await LoadAsync();
            if (taskId is { } id)
            {
                lastCorrection = target is null ? null : new Correction(target, id);
                var ignored = timeline?.Tasks.GetValueOrDefault(id)?.IsIgnored == true;
                Inform(ignored
                    ? (starts.Count > 1 ? "Créneaux retirés de la feuille de temps." : "Créneau retiré de la feuille de temps.")
                    : starts.Count > 1
                        ? $"{starts.Count} créneaux assignés à {TaskName(id)}."
                        : $"Créneau assigné à {TaskName(id)}.");
            }
            else
            {
                Inform(starts.Count > 1 ? "Créneaux marqués comme hors travail." : "Créneau marqué comme hors travail.");
            }
        });
    }

    private void AskRemove(VisibleSlot row) =>
        pendingRemoval = new PendingRemoval([row.Slot.SlotStartUtc], $"{row.Local:HH:mm} – {row.Local.AddMinutes(15):HH:mm}");

    /// <summary>Selected rows not already deleted (those can only show in the whole-day view).</summary>
    private List<int> RemovableSelection() =>
        selection is { } s ? s.Indices.Order().Where(i => !TimesheetUi.IsRemoved(visible[i].Slot)).ToList() : [];

    private string RemoveSelectionLabel() =>
        RemovableSelection().Count == 1 ? "Supprimer le créneau sélectionné et ses activités" : $"Supprimer les {RemovableSelection().Count} créneaux sélectionnés et leurs activités";

    private void AskRemoveSelection()
    {
        var indices = RemovableSelection();
        if (indices.Count == 0)
            return;
        pendingRemoval = new PendingRemoval(indices.Select(i => visible[i].Slot.SlotStartUtc).ToList(), Spans(indices));
    }

    private async Task ConfirmRemoveAsync()
    {
        if (pendingRemoval is not { } removal)
            return;
        pendingRemoval = null;

        await RunAsync(async () =>
        {
            var result = await Weeks.RemoveSlotsAsync(removal.Starts.ToList());
            selection = null;
            await LoadAsync();
            Inform(TimesheetUi.RemovalResultMessage(result));
        });
    }

    private async Task ClearOverridesAsync()
    {
        var starts = SelectedStarts();
        if (starts.Count == 0)
            return;

        await RunAsync(async () =>
        {
            await Weeks.ClearSlotStartsAsync(starts);
            selection = null;
            await LoadAsync();
            Inform("Assignation manuelle annulée : le moteur décide à nouveau pour ces créneaux.");
        });
    }

    private async Task PreviewRuleAsync(CorrectionTarget target, int taskId)
    {
        await RunAsync(async () =>
        {
            var preview = await Weeks.ProposeRuleFromCorrectionAsync(target, taskId);
            if (preview is null)
            {
                Fail("Aucune règle stable n'a pu être déduite de l'activité de ces créneaux.");
                return;
            }
            pendingRule = new PendingRule(target, taskId, preview);
        });
    }

    private async Task ConfirmRuleAsync()
    {
        if (pendingRule is not { } pending)
            return;

        await RunAsync(async () =>
        {
            var rule = await Weeks.CreateRuleFromCorrectionAsync(pending.Target, pending.TaskId);
            pendingRule = null;
            if (rule is null)
            {
                Fail("La règle n'a pas pu être créée : aucune valeur stable trouvée.");
                return;
            }
            selection = null;
            await LoadAsync();
            Inform($"Règle créée : « {rule.Name} » → {TaskName(rule.ForecastTaskId)}.");
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (busy)
            return;
        busy = true;
        message = null;
        lastCorrection = null;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Day action failed");
            Fail($"L'opération a échoué : {ex.Message}");
        }
        finally
        {
            busy = false;
        }
    }

    private void Inform(string text) => (message, messageIsError) = (text, false);

    private void Fail(string text)
    {
        (message, messageIsError) = (text, true);
        lastCorrection = null;
    }

    private void ClearMessage()
    {
        message = null;
        lastCorrection = null;
    }

    private void ToggleExpanded(DateTime slotStart)
    {
        if (!expanded.Remove(slotStart))
            expanded.Add(slotStart);
    }

    // Labels

    private string TaskName(int taskId) =>
        TimesheetUi.TaskLabel(timeline?.Tasks.GetValueOrDefault(taskId), taskId);

    private string SlotLabel(SlotAssignment slot) => slot switch
    {
        { Kind: SlotKind.ExcludedByOverride } => "Pas du travail",
        { Kind: SlotKind.Removed } => "Supprimé",
        { Kind: SlotKind.Ignored } => "Ignoré",
        { IsWork: true, TaskId: { } id } => TaskName(id),
        { IsWork: true, GroupKey: { } key } => $"Non classé · {TimesheetUi.GroupLabel(key)}",
        { IsWork: true } => "Non classé",
        { Kind: SlotKind.Empty, Evidence.Count: > 0 } => "Activité trop brève (non comptée)",
        _ => "",
    };

    private string CandidateLabel(SlotCandidate candidate) =>
        candidate.TaskId is { } id ? TaskName(id)
        : candidate.GroupKey is { } key ? TimesheetUi.GroupLabel(key)
        : "?";

    private static string KindClass(SlotAssignment slot) => slot.Kind switch
    {
        SlotKind.Activity => slot.TaskId is null ? "kind-activity unclassified" : "kind-activity",
        SlotKind.Meeting => slot.TaskId is null ? "kind-meeting unclassified" : "kind-meeting",
        SlotKind.Override => "kind-override",
        SlotKind.ExcludedByOverride or SlotKind.Ignored => "kind-excluded",
        _ => "kind-empty",
    };

    private IEnumerable<ActivityEvent> Evidence(SlotAssignment slot) =>
        slot.Evidence
            .Select(id => timeline!.Activities.GetValueOrDefault(id))
            .OfType<ActivityEvent>()
            .OrderBy(a => a.StartUtc);

    private string SlotTitle(VisibleSlot row)
    {
        var label = SlotLabel(row.Slot);
        var head = $"{row.Local:HH:mm} – {row.Local.AddMinutes(15):HH:mm} · {TimesheetUi.SlotKindLabel(row.Slot.Kind)}";
        var titles = Evidence(row.Slot)
            .Select(a => a.Title ?? a.Subject ?? a.ProcessName)
            .OfType<string>()
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct()
            .Take(3)
            .ToList();
        var parts = new List<string> { head };
        if (label.Length > 0)
            parts.Add(label);
        parts.AddRange(titles);
        return string.Join("\n", parts);
    }

    private string ActivityTime(ActivityEvent activity)
    {
        var tz = Allocator.TimeZone;
        var start = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(activity.StartUtc, DateTimeKind.Utc), tz);
        if (activity.EndUtc is not { } endUtc)
            return start.ToString("HH:mm");
        var end = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(endUtc, DateTimeKind.Utc), tz);
        return $"{start:HH:mm}–{end:HH:mm}";
    }
}
