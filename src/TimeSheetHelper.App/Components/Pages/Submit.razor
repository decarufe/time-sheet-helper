@page "/soumettre"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using TimeSheetHelper.App.Components.Shared
@using TimeSheetHelper.App.Services
@using TimeSheetHelper.Core.Forecast
@using TimeSheetHelper.Core.Timesheets
@using TimeSheetHelper.Engine
@using TimeSheetHelper.Forecast
@using TimeSheetHelper.Forecast.Submission
@using TimeSheetHelper.Storage
@inject WeekService Weeks
@inject ForecastRunner ForecastOps
@inject ForecastTaskLinker Linker
@inject ForecastTaskReader TaskReader
@inject ForecastTaskCatalog Catalog
@inject SubmissionReviewService Review
@inject IDbContextFactory<TimeSheetDbContext> DbFactory
@inject NavigationManager Navigation
@inject ShellState Shell
@inject INavSummaryService NavSummaries
@inject IDaySubmissionService DaySubmissions
@inject ILogger<Submit> Logger

<PageTitle>Soumettre — Time Sheet Helper</PageTitle>

<div class="page">
    @* The week is chosen in the shell header (ShellWeekSync); the page title is its single h1. *@
    <PageHeader Title="Soumettre à Forecast" />

    <details class="notice">
        <summary>Comment ça marche</summary>
        <p>
            L'envoi crée les entrées de temps du jour dans votre feuille Forecast, puis relit celles du jour pour vérifier.
            Une cellule qui contient déjà d'autres heures n'est jamais modifiée : elle est signalée comme écart.
            Les écarts se règlent ici.
        </p>
        <p>
            <strong>L'envoi pour approbation n'est pas automatisé :</strong> une fois les heures vérifiées, ouvrez Forecast
            et soumettez la semaine vous-même.
        </p>
    </details>

    <section class="cplus" aria-labelledby="cplus-title">
        <h2 id="cplus-title">Soumission jour par jour</h2>
        <p class="muted cplus-intro">
            Chaque jour est relu dans Forecast juste avant d'écrire : une saisie déjà présente n'est jamais créée de nouveau,
            et rien n'est modifié ni retiré dans Forecast sans votre confirmation.
        </p>
        <p class="cplus-live" role="status">@dayAnnouncement</p>
        @if (dayAlert is not null)
        {
            <p class="alert error" role="alert">@dayAlert</p>
        }
        <DayStrip Days="DayCards" Selected="selectedDay" OnSelect="SelectDayAsync" />
        <SendReadyBar Days="StripDays" Plans="dayPlans" Errors="dayErrors" Busy="@(dayReading.Count > 0 || sendingDay is not null)"
                      Sending="sendingReady" OnPrepare="PrepareReadyAsync" OnSend="SendReadyDaysAsync" />
        @if (selectedDay is { } shownDay)
        {
            <DayPanel Date="shownDay" Plan="@(dayPlans.GetValueOrDefault(shownDay))" Loading="dayReading.Contains(shownDay)"
                      Error="@(dayErrors.GetValueOrDefault(shownDay))" Sending="sendingDay == shownDay"
                      Busy="@(sendingReady || (sendingDay is not null && sendingDay != shownDay))" IsToday="shownDay == Today"
                      Choices="ChoicesOf(shownDay)" Journal="dayJournal" OnChoose="c => Choose(shownDay, c.ForecastTaskId, c.Resolution)"
                      OnSend="() => SendDayAsync(shownDay)" OnReplan="() => ReplanDayAsync(shownDay)" OnCancel="() => CancelDayAsync(shownDay)" />
        }
    </section>

    @if (loadError is not null)
    {
        <p class="alert error" role="alert">@loadError</p>
        <button type="button" @onclick="LoadAsync">Réessayer</button>
    }
    else if (draft is null)
    {
        <p class="muted" role="status">Calcul du brouillon de la semaine…</p>
    }
    else
    {
        <OpStatus State="@actionOp" />

        @if (analysisError is not null)
        {
            <p class="alert error" role="alert">@analysisError</p>
        }

        <GapList @ref="gapList" Board="board" Filter="filter" FilterChanged="OnFilterChanged"
                 ActionsFor="ActionsFor" OpenPanelFor="OpenPanelFor" Busy="AnyBusy" Updating="Updating"
                 Analyzing="@(analysis is null && analyzing)" Resolved="session.Resolved"
                 OnAction="OnGapActionAsync" OnRestore="Restore">
            <Panel Context="gap">
                @if (panel is { } open && open.GapId == gap.Id && gap.Cell is { } cell)
                {
                    if (open.Resolution == SubmissionGapResolution.LinkTask)
                    {
                        <RelinkPanel LocalTaskName="@cell.TaskName" InitialQuery="@RelinkQuery(cell)" Disabled="AnyBusy"
                                     OnPick="match => RequestRelinkAsync(gap, match)" OnCancel="ClosePanel" />
                    }
                    else if (open.Resolution == SubmissionGapResolution.CreateTask)
                    {
                        <div class="edit-panel">
                            <NewTaskForm EditTaskId="cell.ForecastTaskId" SubmitLabel="Enregistrer la tâche" OnCreated="OnTaskEditedAsync" OnCancel="ClosePanel" />
                        </div>
                    }
                }
            </Panel>
        </GapList>
    }
</div>

@if (pendingMerge is { } merge)
{
    <ConfirmDialog Title="@SubmitDialogs.MergeTitle(merge.Impact)" Message="@SubmitDialogs.MergeMessage(merge.Impact)" ConfirmLabel="Fusionner et supprimer la tâche locale"
                   OnConfirm="ConfirmMergeAsync" OnCancel="CancelMerge" />
}

@code {
    private sealed record OpenPanel(string GapId, SubmissionGapResolution Resolution);

    private sealed record PendingMerge(int LocalTaskId, ForecastRemoteTask Remote, SubmitDialogs.MergeImpact Impact);

    [SupplyParameterFromQuery(Name = "semaine")]
    public string? Semaine { get; set; }

    private DateOnly monday = UiLabels.MondayOf(DateOnly.FromDateTime(DateTime.Today));
    private DateOnly? loadedWeek;
    private string? loadError;
    private bool draftRefreshing;
    private TimesheetDraft? draft;
    private Dictionary<int, ForecastTask> tasks = [];

    private OpState actionOp = OpState.Idle;
    private bool actionBusy;

    private SubmissionAnalysis? analysis;
    private SubmissionGap? failureGap;
    private string? analysisError;
    private bool analyzing;

    private readonly SessionGapState session = new();
    private readonly AnalysisSequencer analyses = new();
    private ShellWeekSync weekSync = default!;
    private bool disposed;

    private GapFilter filter = GapFilter.None;
    private GapBoard board = GapBoard.Build([], new SessionGapState());
    private GapActionContext actionContext = new(default, _ => true);

    private OpenPanel? panel;
    private PendingMerge? pendingMerge;
    private string? actedGapId;
    private IReadOnlyList<string> actedOrder = [];
    private string? pendingFocus;
    private bool hasPendingFocus;
    private GapList? gapList;

    private bool AnyBusy => actionBusy || DayBusy;

    /// <summary>A send per day (one day or the ready days) or a re-read of Forecast runs.</summary>
    private bool DayBusy => sendingDay is not null || sendingReady || dayReading.Count > 0;

    private NavSummary? daySummary;
    private readonly Dictionary<DateOnly, DayPlan> dayPlans = [];
    private readonly Dictionary<DateOnly, string> dayErrors = [];
    private readonly HashSet<DateOnly> dayReading = [];
    private readonly Dictionary<DateOnly, Dictionary<int, ConflictResolution>> dayChoices = [];
    private IReadOnlyList<SubmissionJournalEntry> dayJournal = [];
    private DateOnly? selectedDay;
    private DateOnly? sendingDay;
    private bool sendingReady;
    private string? dayAnnouncement;
    private string? dayAlert;
    private CancellationTokenSource daysCts = new();

    /// <summary>The data on screen is being replaced: the cards are greyed until the new analysis lands (the screen is never emptied).</summary>
    private bool Updating => draftRefreshing || analyzing;

    protected override void OnInitialized() =>
        weekSync = new ShellWeekSync(Shell, week => _ = InvokeAsync(() => OnShellWeekRequested(week)));

    protected override async Task OnParametersSetAsync()
    {
        // Without ?semaine= the page shows the week of the shell (the current week on arrival).
        monday = DateOnly.TryParseExact(Semaine, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day)
            ? UiLabels.MondayOf(day)
            : Shell.WeekStart;
        weekSync.Show(monday);

        // Rebuilding the draft may call the classifier: only once, in the interactive render (not the prerender).
        if (!RendererInfo.IsInteractive || loadedWeek == monday)
            return;
        var week = monday;
        await LoadAsync();
        if (week == monday && !disposed)
            await LoadDaysAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (hasPendingFocus && gapList is not null)
        {
            var target = pendingFocus;
            hasPendingFocus = false;
            pendingFocus = null;
            gapList.RequestFocus(target);
        }
    }

    public void Dispose()
    {
        disposed = true;
        daysCts.Cancel();
        daysCts.Dispose();
        weekSync?.Dispose();
        analyses.Dispose();
    }

    private void Refresh()
    {
        if (!disposed)
            StateHasChanged();
    }

    // Day by day submission (C+): every read and write goes through IDaySubmissionService.

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private static readonly IReadOnlyDictionary<int, ConflictResolution> NoChoices = new Dictionary<int, ConflictResolution>();

    /// <summary>Monday to Friday, plus a weekend day only when it holds hours.</summary>
    private IReadOnlyList<DateOnly> StripDays =>
        Enumerable.Range(0, 7).Select(i => monday.AddDays(i)).Where(d => d.DayOfWeek is not (DayOfWeek.Saturday or DayOfWeek.Sunday) || HasHours(d)).ToList();

    private IReadOnlyList<DayCard> DayCards => StripDays.Select(DayCardOf).ToList();

    private bool HasHours(DateOnly day) =>
        daySummary?.Days.FirstOrDefault(d => d.Date == day) is { ClassifiedHours: > 0 } || (dayPlans.TryGetValue(day, out var plan) && plan.Cells.Count > 0);

    private DayCard DayCardOf(DateOnly day)
    {
        var summary = daySummary?.Days.FirstOrDefault(d => d.Date == day);
        var state = sendingDay == day ? DayStateLabels.Day(DayStatus.InProgress, true)
            : dayErrors.ContainsKey(day) ? DayStateLabels.ReadFailed
            : dayPlans.TryGetValue(day, out var plan) ? DayStateLabels.Day(plan)
            : DayStateLabels.Reading;
        return new DayCard(day, state, summary?.ClassifiedHours, summary?.TargetHours, day == Today);
    }

    private IReadOnlyDictionary<int, ConflictResolution> ChoicesOf(DateOnly day) => dayChoices.TryGetValue(day, out var c) ? c : NoChoices;

    private async Task LoadDaysAsync()
    {
        daysCts.Cancel();
        daysCts.Dispose();
        daysCts = new CancellationTokenSource();
        var ct = daysCts.Token;
        var week = monday;

        daySummary = null;
        dayPlans.Clear();
        dayErrors.Clear();
        dayReading.Clear();
        dayChoices.Clear();
        dayJournal = [];
        dayAnnouncement = null;
        dayAlert = null;
        selectedDay = Today >= week && Today < week.AddDays(7) ? Today : week;

        try
        {
            daySummary = await NavSummaries.GetAsync(week, ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Week summary for the day strip failed ({ExceptionType}).", ex.GetType().Name);
        }
        if (ct.IsCancellationRequested || disposed)
            return;

        if (selectedDay is { } chosen && !StripDays.Contains(chosen))
            selectedDay = week;
        Refresh();
        await LoadJournalAsync(selectedDay!.Value, ct);
        foreach (var day in StripDays)
            await PlanDayAsync(day, ct);
    }

    private async Task PlanDayAsync(DateOnly day, CancellationToken ct)
    {
        if (ct.IsCancellationRequested || disposed)
            return;
        dayReading.Add(day);
        Refresh();
        try
        {
            var plan = await DaySubmissions.PlanAsync(day, ct);
            if (ct.IsCancellationRequested)
                return;
            dayPlans[day] = plan;
            dayErrors.Remove(day);
            if (dayChoices.TryGetValue(day, out var choices))
                DayStateLabels.KeepValidChoices(plan, choices);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            if (ct.IsCancellationRequested)
                return;
            dayErrors[day] = "Lecture de Forecast impossible : vérifiez la connexion à Forecast puis réessayez.";
            Logger.LogWarning("Day plan failed ({ExceptionType}).", ex.GetType().Name);
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                dayReading.Remove(day);
                Refresh();
            }
        }
    }

    private async Task LoadJournalAsync(DateOnly day, CancellationToken ct)
    {
        try
        {
            var journal = await DaySubmissions.GetJournalAsync(day, ct);
            if (!ct.IsCancellationRequested && selectedDay == day)
            {
                dayJournal = journal;
                Refresh();
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Day journal failed ({ExceptionType}).", ex.GetType().Name);
        }
    }

    private async Task SelectDayAsync(DateOnly day)
    {
        if (selectedDay == day)
            return;
        selectedDay = day;
        dayJournal = [];
        await LoadJournalAsync(day, daysCts.Token);
    }

    private void Choose(DateOnly day, int forecastTaskId, ConflictResolution resolution)
    {
        if (!dayChoices.TryGetValue(day, out var choices))
            dayChoices[day] = choices = [];
        choices[forecastTaskId] = resolution;
        dayAnnouncement = $"{DayStateLabels.Resolution(resolution)} choisi : rien n'est écrit avant l'envoi du jour.";
    }

    private async Task ReplanDayAsync(DateOnly day)
    {
        if (dayReading.Contains(day) || sendingDay == day)
            return;
        await PlanDayAsync(day, daysCts.Token);
        if (!dayErrors.ContainsKey(day))
            dayAnnouncement = $"Forecast relu pour {DayStateLabels.LongDay(day)} : rien n'a été écrit.";
    }

    private async Task SendDayAsync(DateOnly day)
    {
        // One send at a time: a second click while a send runs does nothing.
        if (sendingDay is not null || sendingReady || !dayPlans.ContainsKey(day))
            return;
        var week = monday;
        sendingDay = day;
        dayAlert = null;
        dayAnnouncement = $"Envoi de {DayStateLabels.LongDay(day)} en cours…";
        Refresh();
        try
        {
            // Not tied to the page: leaving it does not cut a send in the middle (« Annuler l'envoi » does).
            var result = await DaySubmissions.SendAsync(day, new Dictionary<int, ConflictResolution>(ChoicesOf(day)));
            if (week == monday && !disposed)
            {
                dayAnnouncement = $"{DayStateLabels.LongDay(day)} : {result.Message}";
                dayChoices.Remove(day);
            }
        }
        catch (Exception ex)
        {
            if (week == monday && !disposed)
            {
                dayAnnouncement = null;
                dayAlert = $"L'envoi de {DayStateLabels.LongDay(day)} a échoué : consultez le journal du jour, puis relancez-le.";
            }
            Logger.LogWarning("Day send failed ({ExceptionType}).", ex.GetType().Name);
        }
        finally
        {
            sendingDay = null;
        }
        NavSummaries.Invalidate(week);
        if (week != monday || disposed)
            return;
        Refresh();
        var ct = daysCts.Token;
        await PlanDayAsync(day, ct);
        if (selectedDay == day)
            await LoadJournalAsync(day, ct);
    }

    private async Task CancelDayAsync(DateOnly day)
    {
        if (sendingDay != day)
            return;
        try
        {
            await DaySubmissions.CancelAsync(day);
            dayAnnouncement = "Annulation demandée : ce qui n'a pas été écrit le sera au rejeu.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Day send cancel failed ({ExceptionType}).", ex.GetType().Name);
        }
    }

    /// <summary>Reads Forecast again for every day of the strip before the confirmation of « Soumettre les jours prêts ».</summary>
    private async Task PrepareReadyAsync()
    {
        var ct = daysCts.Token;
        foreach (var day in StripDays)
            await PlanDayAsync(day, ct);
    }

    private async Task SendReadyDaysAsync()
    {
        if (sendingDay is not null || sendingReady)
            return;
        var week = monday;
        sendingReady = true;
        dayAlert = null;
        dayAnnouncement = "Envoi des jours prêts en cours…";
        Refresh();
        try
        {
            var result = await DaySubmissions.SendReadyAsync(week);
            if (week == monday && !disposed)
                dayAnnouncement = ReadyMessage(result);
        }
        catch (Exception ex)
        {
            if (week == monday && !disposed)
            {
                dayAnnouncement = null;
                dayAlert = "L'envoi des jours prêts a échoué : consultez l'état de chaque jour, puis relancez.";
            }
            Logger.LogWarning("Ready days send failed ({ExceptionType}).", ex.GetType().Name);
        }
        finally
        {
            sendingReady = false;
        }
        NavSummaries.Invalidate(week);
        if (week != monday || disposed)
            return;
        Refresh();
        var ct = daysCts.Token;
        foreach (var day in StripDays)
            await PlanDayAsync(day, ct);
        if (selectedDay is { } shown)
            await LoadJournalAsync(shown, ct);
    }

    private static string ReadyMessage(SendReadyResult result)
    {
        if (result.Sent.Count == 0)
            return "Rien de nouveau à envoyer : aucun jour n'était prêt.";
        var sent = string.Join(" ; ", result.Sent.Select(s => $"{DayStateLabels.ShortDay(s.Date)} : {s.Message}"));
        var message = result.Sent.Count == 1 ? $"1 jour envoyé — {sent}" : $"{result.Sent.Count} jours envoyés — {sent}";
        if (result.SkippedDays.Count > 0)
            message += " Non envoyés : " + string.Join(" ; ", result.SkippedDays.Select(s => $"{DayStateLabels.ShortDay(s.Date)} ({s.Reason})")) + ".";
        return message;
    }

    // Week and draft

    private void GoToWeek(DateOnly day) =>
        Navigation.NavigateTo($"soumettre?semaine={TimesheetUi.IsoDate(UiLabels.MondayOf(day))}", replace: true);

    /// <summary>
    /// The header asks for another week. While an operation runs the page keeps its week (the former week buttons
    /// were disabled then): the header goes back to it.
    /// </summary>
    private void OnShellWeekRequested(DateOnly week)
    {
        if (disposed || !weekSync.IsPending)
            return;
        if (AnyBusy)
            weekSync.Show(monday);
        else
            GoToWeek(week);
    }

    /// <summary>Everything the page knows about a week: dropped when the week changes.</summary>
    private void ResetWeekState()
    {
        analyses.Cancel();
        draft = null;
        actionOp = OpState.Idle;
        analysis = null;
        failureGap = null;
        analysisError = null;
        analyzing = actionBusy = false;
        session.Reset();
        filter = GapFilter.None;
        panel = null;
        pendingMerge = null;
        actedGapId = null;
        RebuildView();
    }

    private async Task LoadAsync()
    {
        if (loadedWeek != monday)
            ResetWeekState();
        loadedWeek = monday;
        loadError = null;
        draftRefreshing = true;
        Refresh();
        try
        {
            var week = monday;
            var saved = await Weeks.RebuildDraftAsync(week);
            if (week != monday || disposed)
                return; // The user moved to another week meanwhile.
            await SetDraftAsync(saved.Draft);
            await RefreshAnalysisAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The draft of the week could not be computed.");
            loadError = $"Impossible de calculer le brouillon : {ex.Message}";
        }
        finally
        {
            draftRefreshing = false;
        }
    }

    private async Task SetDraftAsync(TimesheetDraft value)
    {
        draft = value;
        await using (var db = await DbFactory.CreateDbContextAsync())
            tasks = await db.ForecastTasks.AsNoTracking().ToDictionaryAsync(t => t.Id);
        RebuildView();
    }

    private async Task<TimesheetDraft?> ReadDraftAsync(DateOnly week)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.TimesheetDrafts.AsNoTracking().Include(d => d.Entries).FirstOrDefaultAsync(d => d.WeekStart == week);
    }

    // View model: the board, rebuilt when its inputs change.

    private IReadOnlyList<SubmissionGap> AllGaps()
    {
        var gaps = analysis?.Gaps ?? Array.Empty<SubmissionGap>();
        return failureGap is null ? gaps : gaps.Prepend(failureGap).ToList();
    }

    private void RebuildView()
    {
        board = GapBoard.Build(AllGaps(), session, filter);
        actionContext = new GapActionContext(monday, tasks.ContainsKey);
    }

    private IReadOnlyList<GapActionView> ActionsFor(SubmissionGap gap) => GapActionPlanner.Plan(gap, actionContext);

    private SubmissionGapResolution? OpenPanelFor(SubmissionGap gap) => panel is { } open && open.GapId == gap.Id ? open.Resolution : null;

    private string RelinkQuery(SubmissionGapCell cell) => tasks.TryGetValue(cell.ForecastTaskId, out var task) ? task.TaskName : cell.TaskName;

    // Analysis

    /// <summary>Asks the engine where the week stands (gaps and totals). Only the latest analysis counts.</summary>
    private async Task RefreshAnalysisAsync()
    {
        if (draft is null || disposed)
            return;

        var ticket = analyses.Begin();
        analyzing = true;
        Refresh();
        try
        {
            var result = await Review.AnalyzeAsync(draft, null, ticket.Token);
            if (!analyses.IsCurrent(ticket) || disposed)
                return;
            session.Reconcile(result);
            analysis = result;
            analysisError = null;
            RebuildView();
            SettleActedGap();
        }
        catch (OperationCanceledException)
        {
            // Replaced by a newer analysis.
        }
        catch (Exception ex)
        {
            if (!analyses.IsCurrent(ticket))
                return;
            Logger.LogWarning(ex, "The week could not be analysed.");
            analysisError = $"Impossible d'analyser la semaine : {ex.Message}";
        }
        finally
        {
            if (analyses.IsCurrent(ticket))
            {
                analyzing = false;
                Refresh();
            }
        }
    }

    /// <summary>The identity of a task changed (linked, edited, reactivated, synchronised): the draft and the analysis are read again.</summary>
    private async Task AfterTaskChangedAsync()
    {
        var current = await ReadDraftAsync(monday);
        if (current is not null)
            await SetDraftAsync(current);
        else
            RebuildView();

        await RefreshAnalysisAsync();
    }

    /// <summary>Once the new analysis is in: if the gap the user acted on is gone, the focus goes to the next one.</summary>
    private void SettleActedGap()
    {
        if (actedGapId is not { } id)
            return;

        if (board.Visible.All(g => g.Id != id))
        {
            pendingFocus = board.FocusAfterRemoval(actedOrder, id);
            hasPendingFocus = true;
        }

        actedGapId = null;
    }

    // Actions of the gap cards

    private async Task OnGapActionAsync((SubmissionGap Gap, SubmissionGapResolution Resolution) call)
    {
        var (gap, resolution) = call;
        if (resolution is SubmissionGapResolution.LinkTask or SubmissionGapResolution.CreateTask)
        {
            panel = panel is { } open && open.GapId == gap.Id && open.Resolution == resolution ? null : new OpenPanel(gap.Id, resolution);
            return;
        }

        MarkActed(gap.Id);
        switch (resolution)
        {
            case SubmissionGapResolution.RefreshTasks:
                await RefreshTasksAsync();
                break;
            case SubmissionGapResolution.ReactivateTask:
                await ReactivateTaskAsync(gap);
                break;
            case SubmissionGapResolution.RecalculateDraft:
                await LoadAsync();
                break;
            case SubmissionGapResolution.Retry:
                failureGap = null;
                RebuildView();
                await RefreshAnalysisAsync();
                break;
            case SubmissionGapResolution.IgnoreKnowingly:
                Ignore(gap);
                break;
        }
    }

    /// <summary>Remembers the gap the user acts on: once the new analysis is in, the focus follows it (or moves to the next gap).</summary>
    private void MarkActed(string gapId)
    {
        actedGapId = gapId;
        actedOrder = board.Visible.Select(g => g.Id).ToList();
    }

    private void FocusGap(string gapId)
    {
        pendingFocus = gapId;
        hasPendingFocus = true;
    }

    private void ClosePanel()
    {
        if (panel is { } open)
            FocusGap(open.GapId);
        panel = null;
    }

    private void Ignore(SubmissionGap gap)
    {
        if (!session.Ignore(gap))
        {
            actionOp = new OpState(false, null, GapActionPlanner.BlockingCannotBeIgnored);
            return;
        }

        RebuildView();
        SettleActedGap();
    }

    private void OnFilterChanged(GapFilter value)
    {
        filter = value;
        RebuildView();
    }

    private void Restore(string gapId)
    {
        if (!session.Restore(gapId))
            return;
        RebuildView();
        FocusGap(gapId);
    }

    private async Task RunActionAsync(string message, Func<Task<string?>> action)
    {
        actionBusy = true;
        actionOp = new OpState(true, message, null);
        Refresh();
        var week = monday;
        try
        {
            actionOp = new OpState(false, await action(), null);
            NavSummaries.Invalidate(week);
        }
        catch (ForecastAuthRequiredException ex)
        {
            failureGap = Review.CreateFailureGap(ex, monday);
            actionOp = OpState.Idle;
            RebuildView();
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Action of the Submit page failed ({ExceptionType}).", ex.GetType().Name);
            actionOp = new OpState(false, null, $"{message.TrimEnd('…')} impossible : {ex.Message}");
        }
        finally
        {
            actionBusy = false;
            Refresh();
        }
    }

    private Task RefreshTasksAsync() =>
        RunActionAsync("Rafraîchissement des tâches Forecast…", async () =>
        {
            var result = await ForecastOps.RunAsync("synchronisation des tâches", ct => TaskReader.SyncTasksAsync(ct));
            await AfterTaskChangedAsync();
            return result.Summary;
        });

    private Task ReactivateTaskAsync(SubmissionGap gap) =>
        RunActionAsync("Réactivation de la tâche…", async () =>
        {
            if (gap.Cell is not { } cell)
                return null;
            await Catalog.SetActiveAsync([cell.ForecastTaskId], true);
            await AfterTaskChangedAsync();
            return $"Tâche « {cell.TaskName} » réactivée.";
        });

    private async Task OnTaskEditedAsync(int taskId)
    {
        if (panel is { } open)
            MarkActed(open.GapId);
        panel = null;
        await RunActionAsync("Mise à jour de la tâche…", async () =>
        {
            await AfterTaskChangedAsync();
            return "Tâche enregistrée.";
        });
    }

    // Link to a Forecast task: a merge is confirmed first (it deletes the local task).

    private async Task RequestRelinkAsync(SubmissionGap gap, ForecastTaskMatch match)
    {
        if (draft is null || gap.Cell is not { } cell || !tasks.TryGetValue(cell.ForecastTaskId, out var local))
            return;

        MarkActed(gap.Id);
        var remote = RelinkPlan.ToRemote(match);
        if (RelinkPlan.MergeTarget(tasks.Values, local.Id, match.Code) is not { } target)
        {
            await ApplyRelinkAsync(local.Id, remote);
            return;
        }

        int rules;
        await using (var db = await DbFactory.CreateDbContextAsync())
            rules = await db.Rules.CountAsync(r => r.ForecastTaskId == local.Id);
        pendingMerge = new PendingMerge(local.Id, remote, RelinkPlan.ImpactOf(local, target, draft, rules));
    }

    private void CancelMerge()
    {
        pendingMerge = null;
        if (actedGapId is { } id)
            FocusGap(id);
        actedGapId = null;
    }

    private async Task ConfirmMergeAsync()
    {
        if (pendingMerge is not { } merge)
            return;
        pendingMerge = null;
        await ApplyRelinkAsync(merge.LocalTaskId, merge.Remote);
    }

    private Task ApplyRelinkAsync(int localTaskId, ForecastRemoteTask remote)
    {
        panel = null;
        return RunActionAsync("Liaison de la tâche…", async () =>
        {
            var result = await Linker.RelinkAsync(localTaskId, remote);
            await AfterTaskChangedAsync();
            return result.Message;
        });
    }
}
