@page "/soumettre"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using TimeSheetHelper.App.Components.Shared
@using TimeSheetHelper.App.Services
@using TimeSheetHelper.Core.Forecast
@using TimeSheetHelper.Core.Timesheets
@using TimeSheetHelper.Engine
@using TimeSheetHelper.Forecast
@using TimeSheetHelper.Forecast.Submission
@using TimeSheetHelper.Storage
@inject WeekService Weeks
@inject ForecastTimesheetWriter Writer
@inject ForecastRunner ForecastOps
@inject ForecastTaskLinker Linker
@inject ForecastTaskReader TaskReader
@inject ForecastTaskCatalog Catalog
@inject SubmissionReviewService Review
@inject GroupAssignmentService Assignments
@inject IDbContextFactory<TimeSheetDbContext> DbFactory
@inject NavigationManager Navigation
@inject ILogger<Submit> Logger

<PageTitle>Soumettre — Time Sheet Helper</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>Soumettre à Forecast</h1>
        <div class="week-picker">
            <button type="button" class="icon" aria-label="Semaine précédente" disabled="@AnyBusy" @onclick="() => GoToWeek(monday.AddDays(-7))">‹</button>
            <label class="visually-hidden" for="week-day">Semaine</label>
            <input id="week-day" type="date" value="@TimesheetUi.IsoDate(monday)" disabled="@AnyBusy" @onchange="OnDatePicked" />
            <button type="button" class="icon" aria-label="Semaine suivante" disabled="@AnyBusy" @onclick="() => GoToWeek(monday.AddDays(7))">›</button>
            <button type="button" disabled="@AnyBusy" @onclick="() => GoToWeek(UiLabels.MondayOf(DateOnly.FromDateTime(DateTime.Today)))">Cette semaine</button>
            <span class="week-title">@UiLabels.WeekTitle(monday)</span>
        </div>
    </header>

    <details class="notice">
        <summary>Comment ça marche</summary>
        <p>
            La simulation interroge Forecast par son serveur MCP : elle vérifie que chaque tâche est trouvée et indique ce qui serait saisi, sans rien enregistrer.
            La saisie crée ensuite les entrées de temps dans votre feuille Forecast, puis relit celles de la semaine pour vérifier.
            Une cellule qui contient déjà d'autres heures n'est jamais modifiée : elle est signalée comme écart.
            Les écarts se règlent ici ; après une correction, la simulation se relance seule.
        </p>
        <p>
            <strong>L'envoi pour approbation n'est pas automatisé :</strong> une fois les heures vérifiées, ouvrez Forecast
            et soumettez la semaine vous-même.
        </p>
    </details>

    @if (loadError is not null)
    {
        <p class="alert error" role="alert">@loadError</p>
        <button type="button" @onclick="LoadAsync">Réessayer</button>
    }
    else if (draft is null)
    {
        <p class="muted" role="status">Calcul du brouillon de la semaine…</p>
    }
    else
    {
        var status = BuildStatus();

        <SubmissionStatusBar @ref="statusBar" Status="status" Updating="Updating" Busy="AnyBusy" HasSimulation="simulation is not null" HasSelection="selectedDays.Count > 0"
                             ShowActions="draft.SubmittedUtc is null && grid.Rows.Count > 0" OnSimulate="() => SimulateAsync()"
                             OnFill="AskFill" OnGoToGap="GoToGap" FillButtonLabel="@SubmitDialogs.FillButtonLabel(selectedDays, monday)" />

        <OpStatus State="@simulationOp" />
        <OpStatus State="@fillOp" />
        <OpStatus State="@actionOp" />

        <section class="draft" aria-labelledby="draft-title" aria-busy="@(draftRefreshing ? "true" : null)">
            <div class="section-head">
                <h2 id="draft-title">Brouillon — @TimesheetUi.HoursLabel(grid.GrandTotal)</h2>
                <div class="head-actions">
                    @if (draft.SubmittedUtc is null)
                    {
                        <button type="button" disabled="@AnyBusy" @onclick="LoadAsync">Recalculer</button>
                    }
                    <a href="@GapActionPlanner.WeekHref(monday)">Corriger dans la vue Semaine</a>
                </div>
            </div>
            @if (draft.SubmittedUtc is null && grid.Rows.Count > 0)
            {
                <p class="muted day-selection" role="status">
                    @if (selectedDays.Count == 0)
                    {
                        <text>Aucune journée cochée : cochez les jours à simuler et à saisir.</text>
                    }
                    else
                    {
                        <text>Simulation et saisie pour @SubmitDialogs.DaysLabel(selectedDays, monday).</text>
                    }
                    @if (!IsWholeWeek)
                    {
                        <button type="button" class="link" disabled="@AnyBusy" @onclick="SelectWholeWeek">Sélectionner toute la semaine</button>
                    }
                </p>
            }
            @if (draftRefreshing)
            {
                <p class="muted" role="status">Mise à jour du brouillon…</p>
            }

            @if (draft.SubmittedUtc is { } submittedUtc)
            {
                <p class="alert success">
                    Semaine saisie dans Forecast le @UiLabels.LocalDateTime(submittedUtc) : le brouillon n'est plus recalculé.
                    <button type="button" @onclick="ReopenAsync" disabled="@AnyBusy">Rouvrir le brouillon</button>
                </p>
            }

            @if (grid.Rows.Count == 0 && !grid.HasUnclassified)
            {
                <p class="muted empty">Aucune heure classée dans ce brouillon. Attribuez les activités à des tâches dans la vue Semaine.</p>
            }
            else
            {
                <div class="@TableWrapClass">
                    <table class="grid">
                        <caption class="visually-hidden">Brouillon de la semaine, en heures : tâches classées, travail non classé et objectif</caption>
                        <thead>
                            <tr>
                                <th scope="col">Tâche</th>
                                @foreach (var day in grid.Days)
                                {
                                    <th scope="col" class="num day-col">
                                        @if (draft.SubmittedUtc is null)
                                        {
                                            <label class="day-toggle">
                                                <input type="checkbox" checked="@selectedDays.Contains(day)" disabled="@AnyBusy"
                                                       aria-label="@($"Inclure {UiLabels.Day(day)} dans la simulation et la saisie")"
                                                       @onchange="e => ToggleDay(day, e.Value is bool v && v)" />
                                                @UiLabels.Day(day)
                                            </label>
                                        }
                                        else
                                        {
                                            @UiLabels.Day(day)
                                        }
                                    </th>
                                }
                                <th scope="col" class="num">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in grid.Rows)
                            {
                                <tr>
                                    <th scope="row" class="task-name" style="@TimesheetUi.TaskStyle(row.TaskId)">@row.Name</th>
                                    @foreach (var day in grid.Days)
                                    {
                                        var hours = row.Hours.GetValueOrDefault(day);
                                        var gapRef = grid.GapOf(row.TaskId, day);
                                        if (gapRef is not null && hours > 0)
                                        {
                                            <td class="num cell-gap @GapLabels.SeverityClass(gapRef.Severity)">
                                                <button type="button" class="cell-btn" aria-describedby="@GapLabels.DomId(gapRef.GapId)" @onclick="() => GoToGap(gapRef.GapId)"
                                                        aria-label="@($"{row.Name}, {UiLabels.Day(day)} : {TimesheetUi.HoursLabel(hours)}. {GapLabels.Severity(gapRef.Severity)} : {gapRef.Title}. Aller à l'écart.")">
                                                    <span aria-hidden="true">@GapLabels.SeveritySymbol(gapRef.Severity)</span> @TimesheetUi.Hours(hours)
                                                </button>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="@NumClass(hours)">@HoursCell(hours)</td>
                                        }
                                    }
                                    <td class="num total">@TimesheetUi.Hours(row.Total)</td>
                                </tr>
                            }
                            @if (grid.HasUnclassified)
                            {
                                <tr class="readonly">
                                    <th scope="row">
                                        Non classé
                                        <span class="muted note">hors total</span>
                                        @if (draft.SubmittedUtc is null)
                                        {
                                            <a class="inline-link" href="@GapActionPlanner.WeekHref(monday, unclassified: true)">Classer dans la vue Semaine</a>
                                        }
                                    </th>
                                    @foreach (var day in grid.Days)
                                    {
                                        var hours = grid.Unclassified.GetValueOrDefault(day);
                                        <td class="@NumClass(hours)">@HoursCell(hours)</td>
                                    }
                                    <td class="num total">@TimesheetUi.Hours(grid.UnclassifiedTotal)</td>
                                </tr>
                            }
                            @if (grid.HasNonProject)
                            {
                                <tr class="readonly">
                                    <th scope="row">
                                        Temps sans projet dans Forecast
                                        <span class="muted note">exclu du total et de la saisie</span>
                                    </th>
                                    @foreach (var day in grid.Days)
                                    {
                                        var hours = grid.NonProject.GetValueOrDefault(day);
                                        <td class="@NumClass(hours)">@HoursCell(hours)</td>
                                    }
                                    <td class="num total">@TimesheetUi.Hours(grid.NonProjectTotal)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th scope="row">Total classé</th>
                                @foreach (var day in grid.Days)
                                {
                                    var flag = grid.FlagOf(day);
                                    <th class="num @DayFlagClass(flag)">
                                        @TimesheetUi.Hours(grid.DayTotals.GetValueOrDefault(day))
                                        @if (flag is ObjectiveFlag.Below or ObjectiveFlag.Above)
                                        {
                                            <span aria-hidden="true">@(flag == ObjectiveFlag.Below ? "▼" : "▲")</span>
                                            <span class="visually-hidden">@(flag == ObjectiveFlag.Below ? "sous l'objectif" : "au-dessus de l'objectif")</span>
                                        }
                                    </th>
                                }
                                <th class="num">@TimesheetUi.Hours(grid.GrandTotal)</th>
                            </tr>
                            @if (grid.Targets is { } targets)
                            {
                                <tr class="readonly">
                                    <th scope="row">Objectif <span class="muted note">lecture seule</span></th>
                                    @foreach (var day in grid.Days)
                                    {
                                        <td class="num">@TimesheetUi.Hours(targets.GetValueOrDefault(day))</td>
                                    }
                                    <td class="num total">@TimesheetUi.Hours(grid.TargetTotal ?? 0)</td>
                                </tr>
                            }
                        </tfoot>
                    </table>
                </div>
            }
        </section>

        @if (analysisError is not null)
        {
            <p class="alert error" role="alert">@analysisError</p>
        }

        <GapList @ref="gapList" Board="board" Filter="filter" FilterChanged="OnFilterChanged"
                 ActionsFor="ActionsFor" OpenPanelFor="OpenPanelFor" Busy="AnyBusy" Updating="Updating"
                 Analyzing="@(analysis is null && analyzing)" HasSimulation="simulation is not null" Resolved="session.Resolved"
                 CleanCells="cleanCells" OnAction="OnGapActionAsync" OnRestore="Restore">
            <Panel Context="gap">
                @if (panel is { } open && open.GapId == gap.Id && gap.Cell is { } cell)
                {
                    if (open.Resolution == SubmissionGapResolution.LinkTask)
                    {
                        <RelinkPanel LocalTaskName="@cell.TaskName" InitialQuery="@RelinkQuery(cell)" Disabled="AnyBusy"
                                     OnPick="match => RequestRelinkAsync(gap, match)" OnCancel="ClosePanel" />
                    }
                    else if (open.Resolution == SubmissionGapResolution.CreateTask)
                    {
                        <div class="edit-panel">
                            <NewTaskForm EditTaskId="cell.ForecastTaskId" SubmitLabel="Enregistrer la tâche" OnCreated="OnTaskEditedAsync" OnCancel="ClosePanel" />
                        </div>
                    }
                }
            </Panel>
        </GapList>
    }
</div>

@if (confirmFill && draft is not null)
{
    <ConfirmDialog Title="@SubmitDialogs.FillTitle(selectedDays, monday)" ConfirmLabel="Oui, saisir les heures" OnConfirm="FillAsync" OnCancel="CancelFill">
        @foreach (var paragraph in FillParagraphs())
        {
            <p>@paragraph</p>
        }
    </ConfirmDialog>
}

@if (pendingMerge is { } merge)
{
    <ConfirmDialog Title="@SubmitDialogs.MergeTitle(merge.Impact)" Message="@SubmitDialogs.MergeMessage(merge.Impact)" ConfirmLabel="Fusionner et supprimer la tâche locale"
                   OnConfirm="ConfirmMergeAsync" OnCancel="CancelMerge" />
}

@code {
    private const int AutoRunDelayMs = 1500;

    private sealed record OpenPanel(string GapId, SubmissionGapResolution Resolution);

    private sealed record PendingMerge(int LocalTaskId, ForecastRemoteTask Remote, SubmitDialogs.MergeImpact Impact);

    [SupplyParameterFromQuery(Name = "semaine")]
    public string? Semaine { get; set; }

    private DateOnly monday = UiLabels.MondayOf(DateOnly.FromDateTime(DateTime.Today));
    private DateOnly? loadedWeek;
    private string? loadError;
    private bool draftRefreshing;
    private TimesheetDraft? draft;
    private Dictionary<int, ForecastTask> tasks = [];

    private ForecastFillReport? simulation;
    private string? simulationFingerprint;
    private DateTime? simulationUtc;
    private ForecastFillReport? fill;
    private OpState simulationOp = OpState.Idle;
    private OpState fillOp = OpState.Idle;
    private OpState actionOp = OpState.Idle;
    private bool actionBusy;
    private bool confirmFill;
    private PendingAssignments pendingAssignments = PendingAssignments.None;
    private bool restoreFillFocus;

    private SubmissionAnalysis? analysis;
    private SubmissionGap? failureGap;
    private string? analysisError;
    private bool analyzing;
    private bool analysisStale;

    private readonly SessionGapState session = new();
    private readonly AnalysisSequencer simulations = new();
    private readonly AnalysisSequencer analyses = new();
    private readonly SemaphoreSlim simulationGate = new(1, 1);
    private DebouncedAction debounce = default!;
    private bool disposed;

    private GapFilter filter = GapFilter.None;
    private GapBoard board = GapBoard.Build([], new SessionGapState());
    private DraftGrid grid = DraftGrid.Build(new TimesheetDraft(), new Dictionary<int, ForecastTask>(), default, null);
    private IReadOnlyList<ForecastCellResult> cleanCells = [];
    private GapActionContext actionContext = new(default, _ => true);

    /// <summary>Days of the displayed week to simulate and fill; other days are left untouched. Empty = nothing to simulate or fill (never the whole week).</summary>
    private HashSet<DateOnly> selectedDays = [];

    /// <summary>The days the current simulation was made for.</summary>
    private HashSet<DateOnly> simulatedDays = [];

    private OpenPanel? panel;
    private PendingMerge? pendingMerge;
    private string? actedGapId;
    private IReadOnlyList<string> actedOrder = [];
    private string? pendingFocus;
    private bool hasPendingFocus;
    private GapList? gapList;
    private SubmissionStatusBar? statusBar;

    private bool AnyBusy => simulationOp.Busy || fillOp.Busy || actionBusy;

    /// <summary>The data on screen is being replaced: the cards are greyed until the new analysis lands (the screen is never emptied).</summary>
    private bool Updating => draftRefreshing || analyzing || analysisStale || simulationOp.Busy;

    private ForecastFillReport? Report => fill ?? simulation;

    private bool SimulationFresh =>
        simulation is not null && draft is not null && simulationFingerprint == FillGuard.Fingerprint(draft) && simulatedDays.SetEquals(selectedDays);

    private string TableWrapClass => draftRefreshing ? "table-wrap updating" : "table-wrap";

    protected override void OnInitialized() =>
        debounce = new DebouncedAction(
            TimeSpan.FromMilliseconds(AutoRunDelayMs),
            ct => InvokeAsync(() => SimulateAsync(auto: true, ct)),
            ex => Logger.LogWarning("Automatic re-simulation failed ({ExceptionType}).", ex.GetType().Name));

    protected override async Task OnParametersSetAsync()
    {
        if (DateOnly.TryParseExact(Semaine, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day))
            monday = UiLabels.MondayOf(day);

        // Days of another week never stay selected, whatever happens to the load below.
        selectedDays = DaySelection.Prune(selectedDays, monday);

        // Rebuilding the draft may call the classifier: only once, in the interactive render (not the prerender).
        if (!RendererInfo.IsInteractive || loadedWeek == monday)
            return;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (hasPendingFocus && gapList is not null)
        {
            var target = pendingFocus;
            hasPendingFocus = false;
            pendingFocus = null;
            gapList.RequestFocus(target);
        }

        if (restoreFillFocus && statusBar is not null)
        {
            restoreFillFocus = false;
            await statusBar.FocusFillAsync();
        }
    }

    public void Dispose()
    {
        disposed = true;
        debounce.Dispose();
        simulations.Dispose();
        analyses.Dispose();
    }

    private void Refresh()
    {
        if (!disposed)
            StateHasChanged();
    }

    // Week and draft

    private void GoToWeek(DateOnly day) =>
        Navigation.NavigateTo($"soumettre?semaine={TimesheetUi.IsoDate(UiLabels.MondayOf(day))}", replace: true);

    private void OnDatePicked(ChangeEventArgs e)
    {
        if (TimesheetUi.TryParseIsoDate(e.Value?.ToString(), out var day))
            GoToWeek(day);
    }

    /// <summary>Everything the page knows about a week: dropped when the week changes or the draft is reopened.</summary>
    private void ResetWeekState()
    {
        debounce.Cancel();
        simulations.Cancel();
        analyses.Cancel();
        draft = null;
        simulation = fill = null;
        simulationFingerprint = null;
        simulationUtc = null;
        simulationOp = fillOp = actionOp = OpState.Idle;
        analysis = null;
        failureGap = null;
        analysisError = null;
        analyzing = analysisStale = actionBusy = confirmFill = false;
        session.Reset();
        filter = GapFilter.None;
        panel = null;
        pendingMerge = null;
        actedGapId = null;
        selectedDays = DaySelection.Default(monday, DateOnly.FromDateTime(DateTime.Today));
        simulatedDays = [];
        RebuildView();
    }

    private bool IsWholeWeek => DaySelection.IsWholeWeek(selectedDays, monday);

    private void ToggleDay(DateOnly day, bool include)
    {
        if (day < monday || day >= monday.AddDays(7))
            return; // Only the days on screen can be selected.
        if (include)
            selectedDays.Add(day);
        else
            selectedDays.Remove(day);
        OnSelectionChanged();
    }

    private void SelectWholeWeek()
    {
        selectedDays = DaySelection.WeekOf(monday).ToHashSet();
        OnSelectionChanged();
    }

    /// <summary>
    /// The gaps shown follow the checked days. A simulation only covers the days it was made for: another selection makes it stale
    /// (the fill needs a simulation of exactly the days it will write), and it is redone by itself unless no day is checked.
    /// </summary>
    private void OnSelectionChanged()
    {
        RebuildView();
        if (simulation is null || draft?.SubmittedUtc is not null)
            return;

        if (SimulationFresh || selectedDays.Count == 0)
        {
            debounce.Cancel();
            analysisStale = false;
            return;
        }

        analysisStale = true;
        debounce.Request();
    }

    private async Task LoadAsync()
    {
        if (loadedWeek != monday)
            ResetWeekState();
        loadedWeek = monday;
        loadError = null;
        draftRefreshing = true;
        Refresh();
        try
        {
            var week = monday;
            var saved = await Weeks.RebuildDraftAsync(week);
            if (week != monday || disposed)
                return; // The user moved to another week meanwhile.
            await SetDraftAsync(saved.Draft);
            await AfterDraftChangedAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The draft of the week could not be computed.");
            loadError = $"Impossible de calculer le brouillon : {ex.Message}";
        }
        finally
        {
            draftRefreshing = false;
        }
    }

    private async Task SetDraftAsync(TimesheetDraft value)
    {
        draft = value;
        await using (var db = await DbFactory.CreateDbContextAsync())
            tasks = await db.ForecastTasks.AsNoTracking().ToDictionaryAsync(t => t.Id);
        RebuildView();
    }

    private async Task<TimesheetDraft?> ReadDraftAsync(DateOnly week)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.TimesheetDrafts.AsNoTracking().Include(d => d.Entries).FirstOrDefaultAsync(d => d.WeekStart == week);
    }

    // View model: the board, the table and the clean cells, rebuilt when their inputs change.

    private IReadOnlyList<SubmissionGap> AllGaps()
    {
        var gaps = analysis?.Gaps ?? Array.Empty<SubmissionGap>();
        return failureGap is null ? gaps : gaps.Prepend(failureGap).ToList();
    }

    private void RebuildView()
    {
        var gaps = AllGaps();
        board = GapBoard.Build(gaps, session, filter, selectedDays);
        cleanCells = GapBoard.CellsWithoutGap(Report, gaps).Where(c => selectedDays.Contains(c.Date)).ToList();
        actionContext = new GapActionContext(monday, tasks.ContainsKey);
        if (draft is not null)
            grid = DraftGrid.Build(draft, tasks, monday, analysis, gap => !session.IsIgnored(gap) && GapBoard.InScope(gap, selectedDays));
    }

    private SubmissionStatus BuildStatus() =>
        SubmissionStatusBuilder.Build(new SubmissionStatusInput(
            analysis,
            board.OpenBlockingCount,
            board.OpenToVerifyCount,
            session.IgnoredCount,
            board.FirstBlocking?.Id,
            draft?.SubmittedUtc is not null,
            grid.Rows.Count > 0,
            simulation is not null,
            SimulationFresh,
            simulation?.Success == true,
            simulationUtc,
            simulationOp.Busy,
            fillOp.Busy,
            draftRefreshing || analyzing,
            DateTime.UtcNow,
            selectedDays.Count > 0));

    private IReadOnlyList<GapActionView> ActionsFor(SubmissionGap gap) => GapActionPlanner.Plan(gap, actionContext);

    private SubmissionGapResolution? OpenPanelFor(SubmissionGap gap) => panel is { } open && open.GapId == gap.Id ? open.Resolution : null;

    private string RelinkQuery(SubmissionGapCell cell) => tasks.TryGetValue(cell.ForecastTaskId, out var task) ? task.TaskName : cell.TaskName;

    private static string NumClass(decimal hours) => hours == 0 ? "num zero" : "num";

    private static string HoursCell(decimal hours) => hours == 0 ? "·" : TimesheetUi.Hours(hours);

    private static string DayFlagClass(ObjectiveFlag flag) => flag switch
    {
        ObjectiveFlag.Below => "day-below",
        ObjectiveFlag.Above => "day-above",
        _ => "",
    };

    // Analysis

    /// <summary>Asks the engine where the week stands (gaps and totals). Only the latest analysis counts.</summary>
    private async Task RefreshAnalysisAsync()
    {
        if (draft is null || disposed)
            return;

        var ticket = analyses.Begin();
        analyzing = true;
        Refresh();
        try
        {
            var result = await Review.AnalyzeAsync(draft, Report, ticket.Token);
            if (!analyses.IsCurrent(ticket) || disposed)
                return;
            session.Reconcile(result);
            analysis = result;
            analysisError = null;
            analysisStale = false;
            RebuildView();
            SettleActedGap();
        }
        catch (OperationCanceledException)
        {
            // Replaced by a newer analysis.
        }
        catch (Exception ex)
        {
            if (!analyses.IsCurrent(ticket))
                return;
            Logger.LogWarning(ex, "The week could not be analysed.");
            analysisError = $"Impossible d'analyser la semaine : {ex.Message}";
            analysisStale = false;
        }
        finally
        {
            if (analyses.IsCurrent(ticket))
            {
                analyzing = false;
                Refresh();
            }
        }
    }

    /// <summary>After a change of the draft: a new simulation when one was made (the screen stays), else only the local analysis.</summary>
    private async Task AfterDraftChangedAsync()
    {
        if (simulation is not null && !SimulationFresh)
        {
            analysisStale = true;
            Refresh();
            debounce.Request();
            return;
        }

        await RefreshAnalysisAsync();
    }

    /// <summary>The identity of a task changed (linked, edited, reactivated, synchronised): what Forecast said about it no longer holds.</summary>
    private async Task AfterTaskChangedAsync()
    {
        var current = await ReadDraftAsync(monday);
        if (current is not null)
            await SetDraftAsync(current);
        else
            RebuildView();

        if (simulation is not null)
        {
            simulationFingerprint = null;
            analysisStale = true;
            Refresh();
            debounce.Request();
            return;
        }

        await RefreshAnalysisAsync();
    }

    /// <summary>Once the new analysis is in: if the gap the user acted on is gone, the focus goes to the next one.</summary>
    private void SettleActedGap()
    {
        if (actedGapId is not { } id)
            return;

        if (board.Visible.All(g => g.Id != id))
        {
            pendingFocus = board.FocusAfterRemoval(actedOrder, id);
            hasPendingFocus = true;
        }

        actedGapId = null;
    }

    // Simulation and fill

    /// <param name="auto">Run by the debounce after a correction (the screen is kept as it is, greyed, until the result).</param>
    private async Task SimulateAsync(bool auto = false, CancellationToken external = default)
    {
        if (!FillGuard.CanSimulate(draft is not null, draft?.SubmittedUtc is not null, disposed, fillOp.Busy, selectedDays.Count > 0))
            return;
        if (!auto)
            debounce.Cancel();

        var ticket = simulations.Begin();
        await simulationGate.WaitAsync(CancellationToken.None);
        try
        {
            if (!simulations.IsCurrent(ticket) || disposed)
                return;

            using var linked = CancellationTokenSource.CreateLinkedTokenSource(ticket.Token, external);
            failureGap = null;
            fill = null;
            fillOp = OpState.Idle;
            simulationOp = new OpState(true, auto ? "Mise à jour de la simulation…" : "Simulation en cours via le serveur MCP de Forecast…", null);
            Refresh();

            var current = await ReadDraftAsync(monday) ?? draft!;
            var fingerprint = FillGuard.Fingerprint(current);
            var days = DaySelection.Prune(selectedDays, monday);
            var report = await ForecastOps.RunAsync("simulation", ct => Writer.FillWeekAsync(current, ForecastSubmitMode.DryRun, days, ct), linked.Token);
            if (!simulations.IsCurrent(ticket) || disposed)
                return;

            simulation = report;
            simulatedDays = days;
            simulationFingerprint = fingerprint;
            simulationUtc = DateTime.UtcNow;
            await SetDraftAsync(current);
            simulationOp = report.Success ? new OpState(false, report.Summary, null) : new OpState(false, null, report.Summary);
            await RefreshAnalysisAsync();
        }
        catch (OperationCanceledException) when (!simulations.IsCurrent(ticket) || disposed || external.IsCancellationRequested)
        {
            // Replaced by a newer simulation (or the page left): the newer one reports.
        }
        catch (Exception ex)
        {
            if (simulations.IsCurrent(ticket))
                FailOperation(ex, forSimulation: true);
        }
        finally
        {
            simulationGate.Release();
            Refresh();
        }
    }

    /// <summary>An operation that could not talk to Forecast: a blocking gap with its way out, or the plain message when Forecast is busy.</summary>
    private void FailOperation(Exception ex, bool forSimulation)
    {
        analysisStale = false;
        if (ex is ForecastBusyException)
        {
            if (forSimulation)
                simulationOp = new OpState(false, null, ex.Message);
            else
                fillOp = new OpState(false, null, ex.Message);
            return;
        }

        Logger.LogWarning("Forecast operation failed ({ExceptionType}).", ex.GetType().Name);
        failureGap = Review.CreateFailureGap(ex, monday);
        simulationOp = fillOp = OpState.Idle;
        RebuildView();
    }

    private async Task AskFill()
    {
        var week = monday;
        PendingAssignments pending;
        try
        {
            pending = PendingAssignments.Of(await Assignments.GetPendingAsync(week));
        }
        catch (Exception ex)
        {
            Logger.LogWarning("The pending group assignments could not be read ({ExceptionType}).", ex.GetType().Name);
            pending = PendingAssignments.None;
        }

        if (!FillGuard.ResultApplies(week, monday, disposed))
            return;
        pendingAssignments = pending;
        confirmFill = true;
    }

    private void CancelFill()
    {
        confirmFill = false;
        restoreFillFocus = true;
    }

    private IReadOnlyList<string> FillParagraphs() =>
        SubmitDialogs.FillParagraphs(
            selectedDays.Sum(d => grid.DayTotals.GetValueOrDefault(d)), simulation?.Cells.Count ?? 0, monday, board.OpenToVerify, session.IgnoredCount,
            analysis?.Summary, pendingAssignments, selectedDays);

    private async Task FillAsync()
    {
        confirmFill = false;
        if (draft is null || DaySelection.Prune(selectedDays, monday).Count == 0)
            return; // Nothing checked: the writer would take an empty scope for the whole week.

        var week = monday;
        var canFill = BuildStatus().CanFill;
        if (FillGuard.Preflight(canFill, draft, simulationFingerprint) != FillPreflight.Allowed)
            return;

        debounce.Cancel();
        failureGap = null;
        fillOp = new OpState(true, "Saisie en cours dans Forecast…", null);
        Refresh();
        try
        {
            var current = await ReadDraftAsync(week);
            if (!FillGuard.ResultApplies(week, monday, disposed))
                return;

            if (current is null || FillGuard.Preflight(canFill, current, simulationFingerprint) != FillPreflight.Allowed)
            {
                fillOp = new OpState(false, null, FillGuard.DraftChangedMessage);
                if (current is not null)
                    await SetDraftAsync(current);
                return;
            }

            var days = DaySelection.Prune(selectedDays, monday);
            var report = await ForecastOps.RunAsync("saisie des heures", ct => Writer.FillWeekAsync(current, ForecastSubmitMode.Fill, days, ct));
            if (FillGuard.ResultApplies(week, monday, disposed))
                fill = report;

            // The hours are in Forecast whatever the page shows now: the mark is stored even when the user moved to another week.
            // Scoped to the selected day(s): the week is marked as typed only once every one of its days has been entered this way.
            var scopeEntered = FillGuard.IsWeekFullyEntered(report, current, tasks, days);
            var weekEntered = scopeEntered && FillGuard.IsWeekFullyEntered(report, current, tasks);
            if (weekEntered)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var stored = await db.TimesheetDrafts.FirstAsync(d => d.Id == current.Id);
                stored.SubmittedUtc = DateTime.UtcNow;
                await db.SaveChangesAsync();
                current.SubmittedUtc = stored.SubmittedUtc;
            }

            if (!FillGuard.ResultApplies(week, monday, disposed))
                return;

            if (weekEntered)
            {
                await SetDraftAsync(current);
                fillOp = new OpState(false, $"{report.Summary}. Toutes les cellules sont vérifiées : la semaine est marquée comme saisie. "
                                            + "Pensez à la soumettre pour approbation dans Forecast.", null);
            }
            else if (scopeEntered)
            {
                await SetDraftAsync(current);
                fillOp = new OpState(false, SubmitDialogs.ScopeEnteredMessage(report.Summary, days, monday), null);
            }
            else
            {
                fillOp = new OpState(false, null, SubmitDialogs.ScopeNotEnteredMessage(report.Summary, days, monday));
            }

            await RefreshAnalysisAsync();
        }
        catch (Exception ex)
        {
            if (FillGuard.ResultApplies(week, monday, disposed))
                FailOperation(ex, forSimulation: false);
        }
        finally
        {
            Refresh();
        }
    }

    private async Task ReopenAsync()
    {
        if (draft is null)
            return;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.TimesheetDrafts.Where(d => d.Id == draft.Id)
                .ExecuteUpdateAsync(s => s.SetProperty(d => d.SubmittedUtc, (DateTime?)null));
        }

        ResetWeekState();
        await LoadAsync();
    }

    // Actions of the gap cards

    private async Task OnGapActionAsync((SubmissionGap Gap, SubmissionGapResolution Resolution) call)
    {
        var (gap, resolution) = call;
        if (resolution is SubmissionGapResolution.LinkTask or SubmissionGapResolution.CreateTask)
        {
            panel = panel is { } open && open.GapId == gap.Id && open.Resolution == resolution ? null : new OpenPanel(gap.Id, resolution);
            return;
        }

        MarkActed(gap.Id);
        switch (resolution)
        {
            case SubmissionGapResolution.RefreshTasks:
                await RefreshTasksAsync();
                break;
            case SubmissionGapResolution.ReactivateTask:
                await ReactivateTaskAsync(gap);
                break;
            case SubmissionGapResolution.RecalculateDraft:
                await LoadAsync();
                break;
            case SubmissionGapResolution.Retry or SubmissionGapResolution.ReadAgain or SubmissionGapResolution.ResumeFill:
                await SimulateAsync();
                break;
            case SubmissionGapResolution.IgnoreKnowingly:
                Ignore(gap);
                break;
        }
    }

    /// <summary>Remembers the gap the user acts on: once the new analysis is in, the focus follows it (or moves to the next gap).</summary>
    private void MarkActed(string gapId)
    {
        actedGapId = gapId;
        actedOrder = board.Visible.Select(g => g.Id).ToList();
    }

    private void FocusGap(string gapId)
    {
        pendingFocus = gapId;
        hasPendingFocus = true;
    }

    private void ClosePanel()
    {
        if (panel is { } open)
            FocusGap(open.GapId);
        panel = null;
    }

    private void Ignore(SubmissionGap gap)
    {
        if (!session.Ignore(gap))
        {
            actionOp = new OpState(false, null, GapActionPlanner.BlockingCannotBeIgnored);
            return;
        }

        RebuildView();
        SettleActedGap();
    }

    private void OnFilterChanged(GapFilter value)
    {
        filter = value;
        RebuildView();
    }

    private void Restore(string gapId)
    {
        if (!session.Restore(gapId))
            return;
        RebuildView();
        FocusGap(gapId);
    }

    /// <summary>Shows the card of a gap (the filter is lifted when it hides it) and gives it the focus.</summary>
    private void GoToGap(string? gapId)
    {
        if (gapId is null)
            return;
        if (filter.IsActive && board.Visible.All(g => g.Id != gapId))
        {
            filter = GapFilter.None;
            RebuildView();
        }

        FocusGap(gapId);
    }

    private async Task RunActionAsync(string message, Func<Task<string?>> action)
    {
        actionBusy = true;
        actionOp = new OpState(true, message, null);
        Refresh();
        try
        {
            actionOp = new OpState(false, await action(), null);
        }
        catch (ForecastAuthRequiredException ex)
        {
            failureGap = Review.CreateFailureGap(ex, monday);
            actionOp = OpState.Idle;
            RebuildView();
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Action of the Submit page failed ({ExceptionType}).", ex.GetType().Name);
            actionOp = new OpState(false, null, $"{message.TrimEnd('…')} impossible : {ex.Message}");
        }
        finally
        {
            actionBusy = false;
            Refresh();
        }
    }

    private Task RefreshTasksAsync() =>
        RunActionAsync("Rafraîchissement des tâches Forecast…", async () =>
        {
            var result = await ForecastOps.RunAsync("synchronisation des tâches", ct => TaskReader.SyncTasksAsync(ct));
            await AfterTaskChangedAsync();
            return result.Summary;
        });

    private Task ReactivateTaskAsync(SubmissionGap gap) =>
        RunActionAsync("Réactivation de la tâche…", async () =>
        {
            if (gap.Cell is not { } cell)
                return null;
            await Catalog.SetActiveAsync([cell.ForecastTaskId], true);
            await AfterTaskChangedAsync();
            return $"Tâche « {cell.TaskName} » réactivée.";
        });

    private async Task OnTaskEditedAsync(int taskId)
    {
        if (panel is { } open)
            MarkActed(open.GapId);
        panel = null;
        await RunActionAsync("Mise à jour de la tâche…", async () =>
        {
            await AfterTaskChangedAsync();
            return "Tâche enregistrée : la simulation va être relancée.";
        });
    }

    // Link to a Forecast task: a merge is confirmed first (it deletes the local task).

    private async Task RequestRelinkAsync(SubmissionGap gap, ForecastTaskMatch match)
    {
        if (draft is null || gap.Cell is not { } cell || !tasks.TryGetValue(cell.ForecastTaskId, out var local))
            return;

        MarkActed(gap.Id);
        var remote = RelinkPlan.ToRemote(match);
        if (RelinkPlan.MergeTarget(tasks.Values, local.Id, match.Code) is not { } target)
        {
            await ApplyRelinkAsync(local.Id, remote);
            return;
        }

        int rules;
        await using (var db = await DbFactory.CreateDbContextAsync())
            rules = await db.Rules.CountAsync(r => r.ForecastTaskId == local.Id);
        pendingMerge = new PendingMerge(local.Id, remote, RelinkPlan.ImpactOf(local, target, draft, rules));
    }

    private void CancelMerge()
    {
        pendingMerge = null;
        if (actedGapId is { } id)
            FocusGap(id);
        actedGapId = null;
    }

    private async Task ConfirmMergeAsync()
    {
        if (pendingMerge is not { } merge)
            return;
        pendingMerge = null;
        await ApplyRelinkAsync(merge.LocalTaskId, merge.Remote);
    }

    private Task ApplyRelinkAsync(int localTaskId, ForecastRemoteTask remote)
    {
        panel = null;
        return RunActionAsync("Liaison de la tâche…", async () =>
        {
            var result = await Linker.RelinkAsync(localTaskId, remote);
            await AfterTaskChangedAsync();
            return result.Message;
        });
    }
}
