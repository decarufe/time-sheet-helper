@page "/sources"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using TimeSheetHelper.App.Plugins
@using TimeSheetHelper.App.Services
@using TimeSheetHelper.App.Sync
@using TimeSheetHelper.Core.Collectors
@using TimeSheetHelper.Core.Secrets
@using TimeSheetHelper.Forecast
@using TimeSheetHelper.Plugins
@using TimeSheetHelper.Storage
@inject PluginHost Plugins
@inject SyncScheduler Scheduler
@inject ISecretStore Secrets
@inject ForecastRunner ForecastOps
@inject IForecastConnector ForecastConnector
@inject ForecastTaskReader TaskReader
@inject IDbContextFactory<TimeSheetDbContext> DbFactory
@inject TimeProvider Clock

<PageTitle>Sources — Time Sheet Helper</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>Sources</h1>
        <p class="muted">
            D'où viennent les activités. Chaque source est un plugin : vous pouvez l'activer, la régler ou la retirer sans redémarrer l'application.
            @if (Scheduler.IsRunning)
            {
                <span class="pill running">Synchronisation en cours@(Scheduler.CurrentCollector is { } c ? $" : {c}" : "")…</span>
            }
            else if (Scheduler.NextRunUtc is { } next)
            {
                <span>Prochaine synchronisation automatique vers @next.ToLocalTime().ToString("HH:mm").</span>
            }
            else
            {
                <span>Synchronisation automatique désactivée.</span>
            }
        </p>
        <button class="primary" disabled="@IsBusy("sync:*")" @onclick="() => SyncAsync(null)">
            @(IsBusy("sync:*") ? "Synchronisation…" : "Tout synchroniser maintenant")
        </button>
        <OpStatus State="@Op("sync:*")" />
    </header>

    <h2>Sources</h2>
    <p class="muted">Les sources « synchronisées » sont interrogées pour la semaine en cours (et la précédente le lundi matin) ; les autres enregistrent en continu ou reçoivent leurs données.</p>
    <div class="cards">
        @foreach (var plugin in Plugins.Plugins)
        {
            var id = plugin.Id;
            var descriptor = plugin.Descriptor;
            var status = statuses.GetValueOrDefault(id);
            var enableKey = "enable:" + id;
            <article class="card">
                <header class="card-head">
                    <h3>@descriptor.DisplayName <span class="code-name">@id</span></h3>
                    @switch (plugin.State)
                    {
                        case PluginRunState.Running when status is null:
                            <span class="pill muted-pill">Vérification…</span>
                            break;
                        case PluginRunState.Running when status!.IsConfigured:
                            <span class="pill ok">@(status.Message ?? "Prête")</span>
                            break;
                        case PluginRunState.Running:
                            <span class="pill warn">À configurer</span>
                            break;
                        case PluginRunState.Failed:
                            <span class="pill warn">Erreur</span>
                            break;
                        case PluginRunState.Unsupported:
                            <span class="pill muted-pill">Non disponible</span>
                            break;
                        default:
                            <span class="pill muted-pill">Désactivée</span>
                            break;
                    }
                </header>
                @if (descriptor.Description is { Length: > 0 } description)
                {
                    <p class="hint">@description</p>
                }
                <p class="hint">@ModeLabel(descriptor.Mode) · @(string.Join(", ", descriptor.Emits.Select(e => e.Traits.DisplayName)))</p>

                @if (plugin.Error is { } error)
                {
                    <p class="@(plugin.State == PluginRunState.Failed ? "error-text" : "muted")">@error</p>
                }
                @if (plugin.State == PluginRunState.Running && status is not null)
                {
                    @if (!status.IsConfigured && status.Message is { } problem)
                    {
                        <p class="warn-text">@problem</p>
                    }
                    @if (status.Details is { Count: > 0 } details)
                    {
                        <dl>
                            @foreach (var detail in details)
                            {
                                <dt>@detail.Label</dt>
                                <dd>@detail.Value</dd>
                            }
                        </dl>
                    }
                }

                @if (plugin.State == PluginRunState.Running)
                {
                    @foreach (var collector in plugin.Collectors)
                    {
                        var name = collector.Name;
                        var last = Scheduler.GetLastResult(name);
                        var key = "sync:" + name;
                        <div class="collector">
                            <strong>@name</strong>
                            @if (last is null)
                            {
                                <span class="muted"> — pas encore synchronisée depuis le démarrage.</span>
                            }
                            else
                            {
                                @switch (last.Outcome)
                                {
                                    case CollectorSyncOutcome.Succeeded:
                                        <span> — @UiLabels.Ago(last.FinishedUtc, Now) : <strong>@last.EventCount</strong> événement(s).</span>
                                        break;
                                    case CollectorSyncOutcome.NotConfigured:
                                        <span> — ignorée @UiLabels.Ago(last.FinishedUtc, Now) : @last.Message</span>
                                        break;
                                    default:
                                        <span class="error-text"> — échec @UiLabels.Ago(last.FinishedUtc, Now) : @last.Message</span>
                                        break;
                                }
                                @if (last.Warnings.Count > 0)
                                {
                                    <ul class="warnings">
                                        @foreach (var warning in last.Warnings.Take(5))
                                        {
                                            <li>@warning</li>
                                        }
                                        @if (last.Warnings.Count > 5)
                                        {
                                            <li class="muted">… et @(last.Warnings.Count - 5) autre(s).</li>
                                        }
                                    </ul>
                                }
                            }
                            <div class="card-actions">
                                <button disabled="@(IsBusy(key) || IsBusy("sync:*"))" @onclick="() => SyncAsync(name)">
                                    @(IsBusy(key) ? "Synchronisation…" : "Synchroniser cette semaine")
                                </button>
                            </div>
                            <OpStatus State="@Op(key)" />
                        </div>
                    }

                    @if (descriptor.PushRoute is { } route)
                    {
                        <p class="hint">
                            Reçoit sur <code>/ingest/@route</code>. L'extension lit le jeton dans <code>@IngestEndpoints.TokenFilePath</code>.
                        </p>
                    }
                }

                @if (status?.Actions is { Count: > 0 } actions && plugin.State == PluginRunState.Running)
                {
                    var actionKey = "action:" + id;
                    <div class="card-actions">
                        @foreach (var action in actions)
                        {
                            <button class="@(action.Primary ? "primary" : null)" disabled="@IsBusy(actionKey)"
                                    @onclick="() => RunActionAsync(plugin, action)">@action.Label</button>
                        }
                    </div>
                    <OpStatus State="@Op(actionKey)" />
                }

                @if (descriptor.Config.Count > 0)
                {
                    <details class="settings" open="@(plugin.State == PluginRunState.Running && status is { IsConfigured: false })">
                        <summary>Réglages</summary>
                        @{ var form = EditsOf(plugin); }
                        @foreach (var field in descriptor.Config)
                        {
                            var inputId = $"cfg-{id}-{field.Key}";
                            <div class="field">
                                <label for="@inputId">@field.Label@(field.Required ? " *" : "")</label>
                                @switch (field.Type)
                                {
                                    case ConfigFieldType.Boolean:
                                        <input id="@inputId" type="checkbox" checked="@IsTrue(form.GetValueOrDefault(field.Key))"
                                               @onchange="e => SetBool(id, field.Key, (bool)e.Value!)" />
                                        break;
                                    case ConfigFieldType.TextList:
                                        <textarea id="@inputId" rows="4" spellcheck="false" placeholder="@field.Placeholder"
                                                  @oninput="e => SetEdit(id, field.Key, e.Value?.ToString())">@form.GetValueOrDefault(field.Key)</textarea>
                                        break;
                                    default:
                                        <input id="@inputId" type="@(field.Type == ConfigFieldType.Number ? "number" : "text")" placeholder="@field.Placeholder"
                                               value="@form.GetValueOrDefault(field.Key)"
                                               @oninput="e => SetEdit(id, field.Key, e.Value?.ToString())" />
                                        break;
                                }
                                @if (field.Help is { Length: > 0 } help)
                                {
                                    <span class="hint">@help</span>
                                }
                            </div>
                        }
                        <div class="card-actions">
                            <button class="primary" disabled="@(IsBusy("cfg:" + id) || !HasChanges(id))" @onclick="() => SaveConfigAsync(plugin)">Enregistrer les réglages</button>
                        </div>
                        <OpStatus State="@Op("cfg:" + id)" />
                    </details>
                }

                @foreach (var secret in descriptor.Secrets)
                {
                    var configured = secretStates.GetValueOrDefault(secret.Name);
                    var key = "secret:" + secret.Name;
                    <div class="secret">
                        <p>
                            <strong>@secret.Label@(secret.Required ? " *" : "")</strong>
                            <span class="pill @(configured ? "ok" : "muted-pill")">@(configured ? "Configuré" : "Absent")</span>
                        </p>
                        @if (secret.Help is { Length: > 0 } secretHelp)
                        {
                            <p class="hint">@secretHelp</p>
                        }
                        <div class="secret-row">
                            <label class="visually-hidden" for="@("in-" + secret.Name)">@secret.Label</label>
                            <input id="@("in-" + secret.Name)" type="password" autocomplete="off" spellcheck="false"
                                   placeholder="@(configured ? "Nouvelle valeur pour remplacer" : "Coller la valeur")"
                                   value="@secretInputs.GetValueOrDefault(secret.Name)"
                                   @oninput="e => secretInputs[secret.Name] = e.Value?.ToString()" />
                            <button class="primary" disabled="@(IsBusy(key) || string.IsNullOrWhiteSpace(secretInputs.GetValueOrDefault(secret.Name)))"
                                    @onclick="() => SaveSecretAsync(plugin, secret)">
                                @(configured ? "Remplacer" : "Enregistrer")
                            </button>
                        </div>
                        @if (configured)
                        {
                            <div class="card-actions">
                                @if (confirmDeleteSecret == secret.Name)
                                {
                                    <span class="confirm">
                                        Supprimer ce jeton ?
                                        <button class="danger" @onclick="() => DeleteSecretAsync(plugin, secret)">Confirmer</button>
                                        <button @onclick="() => confirmDeleteSecret = null">Annuler</button>
                                    </span>
                                }
                                else
                                {
                                    <button class="danger-outline" @onclick="() => confirmDeleteSecret = secret.Name">Supprimer</button>
                                }
                            </div>
                        }
                        <OpStatus State="@Op(key)" />
                    </div>
                }

                <div class="card-actions">
                    @if (plugin.State != PluginRunState.Unsupported)
                    {
                        <button class="@(plugin.Enabled ? null : "primary")" disabled="@IsBusy(enableKey)" @onclick="() => SetEnabledAsync(plugin, !plugin.Enabled)">
                            @(plugin.Enabled ? "Désactiver" : "Activer")
                        </button>
                    }
                    @if (plugin.Descriptor.Id == "focus-tracker")
                    {
                        <a href="activite">Voir l'activité brute</a>
                    }
                </div>
                <OpStatus State="@Op(enableKey)" />
            </article>
        }
    </div>

    <h2>Paquets de plugins</h2>
    <p class="muted">Un paquet est un dossier (ou un fichier .zip) contenant <code>plugin.json</code> et un ou plusieurs plugins de source. Les paquets fournis avec l'application ne peuvent être que désactivés.</p>
    <div class="cards">
        @foreach (var package in Plugins.Packages.OrderBy(p => p.Manifest.Name, StringComparer.CurrentCultureIgnoreCase))
        {
            var manifest = package.Manifest;
            var key = "package:" + manifest.Id;
            <article class="card">
                <header class="card-head">
                    <h3>@manifest.Name <span class="code-name">@manifest.Id @manifest.Version</span></h3>
                    <span class="pill @(package.IsBundled ? "muted-pill" : "ok")">@(package.IsBundled ? "Fourni" : "Installé")</span>
                </header>
                @if (manifest.Description is { Length: > 0 } packageDescription)
                {
                    <p class="hint">@packageDescription</p>
                }
                <p class="hint">Sources : @string.Join(", ", Plugins.Plugins.Where(p => p.Package.Id == manifest.Id).Select(p => p.Descriptor.DisplayName))</p>
                @if (!package.IsBundled)
                {
                    <div class="card-actions">
                        @if (confirmUninstall == manifest.Id)
                        {
                            <span class="confirm">
                                Désinstaller ce paquet ?
                                <button class="danger" @onclick="() => UninstallAsync(manifest.Id)">Confirmer</button>
                                <button @onclick="() => confirmUninstall = null">Annuler</button>
                            </span>
                        }
                        else
                        {
                            <button class="danger-outline" disabled="@IsBusy(key)" @onclick="() => confirmUninstall = manifest.Id">Désinstaller</button>
                        }
                    </div>
                }
                <OpStatus State="@Op(key)" />
            </article>
        }
    </div>
    @foreach (var issue in Plugins.Issues)
    {
        <p class="warn-text">⚠ @issue.Directory : @issue.Message</p>
    }

    <article class="card wide">
        <header class="card-head"><h3>Installer un plugin</h3></header>
        <p class="hint">Indiquez le chemin d'un dossier de plugin ou d'un fichier .zip, ou envoyez un .zip. Un paquet du même identifiant est remplacé. N'installez que des plugins de confiance : ils s'exécutent avec vos droits.</p>
        <div class="secret-row">
            <label class="visually-hidden" for="install-path">Chemin du plugin</label>
            <input id="install-path" type="text" placeholder="C:\plugins\mon-plugin ou C:\plugins\mon-plugin.zip" spellcheck="false"
                   value="@installPath" @oninput="e => installPath = e.Value?.ToString()" />
            <button class="primary" disabled="@(IsBusy("install") || string.IsNullOrWhiteSpace(installPath))" @onclick="InstallFromPathAsync">Installer</button>
        </div>
        <div class="card-actions">
            <label class="upload">Ou envoyer un .zip : <InputFile OnChange="InstallFromUploadAsync" accept=".zip" disabled="@IsBusy("install")" /></label>
        </div>
        <OpStatus State="@Op("install")" />
    </article>

    <h2>Forecast</h2>
    <article class="card wide">
        <header class="card-head">
            <h3>Feuille de temps Forecast</h3>
            <span class="pill @(activeTasks > 0 ? "ok" : "warn")">@activeTasks tâche(s) active(s)</span>
        </header>
        <p class="hint">
            Forecast est joint par son serveur MCP (<code>.mcp.json</code>) : la connexion OAuth se fait dans votre navigateur
            et reste mémorisée (chiffrée) entre deux utilisations.
            @if (lastTaskSeenUtc is { } seen)
            {
                <span>Tâches lues pour la dernière fois @UiLabels.Ago(seen, Now).</span>
            }
        </p>
        @if (ForecastOps.CurrentOperation is { } running)
        {
            <p class="pill running">En cours : @running</p>
        }
        <div class="card-actions">
            <button class="primary" disabled="@ForecastOps.IsBusy" @onclick="ForecastLoginAsync">Se connecter à Forecast</button>
            <button disabled="@ForecastOps.IsBusy" @onclick="ForecastSyncTasksAsync">Synchroniser les tâches</button>
            <button disabled="@(ForecastOps.IsBusy || !forecastHasCredentials)" @onclick="ForecastLogoutAsync">Se déconnecter</button>
            <a href="taches">Modifier la liste des tâches</a>
        </div>
        <OpStatus State="@Op("forecast")" />
    </article>
</div>

@code {
    private const long MaxUploadBytes = 200L * 1024 * 1024;

    private readonly Dictionary<string, SourceStatus?> statuses = [];
    private readonly Dictionary<string, Dictionary<string, string?>> original = [];
    private readonly Dictionary<string, Dictionary<string, string?>> edits = [];
    private readonly Dictionary<string, bool> secretStates = [];
    private readonly Dictionary<string, string?> secretInputs = [];
    private readonly Dictionary<string, OpState> ops = [];
    private string? confirmDeleteSecret;
    private string? confirmUninstall;
    private string? installPath;
    private int activeTasks;
    private DateTime? lastTaskSeenUtc;
    private bool forecastHasCredentials;
    private System.Threading.Timer? refreshTimer;
    private bool disposed;

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    protected override async Task OnInitializedAsync()
    {
        RefreshSecretStates();
        forecastHasCredentials = ForecastConnector.HasCredentials;
        await LoadTaskCountAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        Scheduler.Changed += OnChanged;
        Plugins.Changed += OnPluginsChanged;
        refreshTimer = new System.Threading.Timer(_ => _ = RefreshLiveAsync(), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));

        // Status checks can be slow (gh, MSAL): run them after the first render, in parallel.
        await RefreshStatusesAsync(Plugins.Plugins);
    }

    private OpState Op(string key) => ops.TryGetValue(key, out var state) ? state : OpState.Idle;

    private bool IsBusy(string key) => Op(key).Busy;

    private static string ModeLabel(SourceExecutionMode mode) => mode switch
    {
        SourceExecutionMode.Pull => "Synchronisée",
        SourceExecutionMode.Continuous => "En continu",
        _ => "Reçoit des données",
    };

    private static bool IsTrue(string? value) => string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);

    /// <summary>Runs a long operation without blocking the circuit; the returned text is shown as success.</summary>
    private async Task RunOpAsync(string key, string busyText, Func<Task<string?>> action)
    {
        if (IsBusy(key))
            return;
        ops[key] = new OpState(true, busyText, null);
        StateHasChanged();
        try
        {
            var message = await action();
            ops[key] = new OpState(false, message, null);
        }
        catch (Exception ex)
        {
            ops[key] = new OpState(false, null, ex.Message);
        }
        if (!disposed)
            StateHasChanged();
    }

    private async Task RefreshStatusesAsync(IEnumerable<PluginState> plugins)
    {
        var running = plugins.Where(p => p.State == PluginRunState.Running).ToList();
        await Task.WhenAll(running.Select(async p =>
        {
            statuses[p.Id] = await Plugins.GetStatusAsync(p.Id);
            await InvokeAsync(StateHasChanged);
        }));
    }

    /// <summary>Cheap, frequent refresh: continuous and push sources report live details; pull sources only on demand.</summary>
    private async Task RefreshLiveAsync()
    {
        if (disposed)
            return;
        await RefreshStatusesAsync(Plugins.Plugins.Where(p => p.Descriptor.Mode != SourceExecutionMode.Pull));
        await InvokeAsync(StateHasChanged);
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnPluginsChanged()
    {
        if (disposed)
            return;

        // A source that was switched, reconfigured or installed: its old status and form values are stale.
        foreach (var id in statuses.Keys.Except(Plugins.Plugins.Where(p => p.State == PluginRunState.Running).Select(p => p.Id)).ToList())
            statuses.Remove(id);
        RefreshSecretStates();
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await RefreshStatusesAsync(Plugins.Plugins);
        });
    }

    private Dictionary<string, string?> EditsOf(PluginState plugin)
    {
        if (!edits.TryGetValue(plugin.Id, out var current))
        {
            original[plugin.Id] = new Dictionary<string, string?>(Plugins.GetConfigValues(plugin.Id), StringComparer.OrdinalIgnoreCase);
            edits[plugin.Id] = current = new Dictionary<string, string?>(original[plugin.Id], StringComparer.OrdinalIgnoreCase);
        }

        return current;
    }

    private void SetEdit(string pluginId, string key, string? value) => edits[pluginId][key] = value;

    private void SetBool(string pluginId, string key, bool value) => SetEdit(pluginId, key, value ? "true" : "false");

    private bool HasChanges(string pluginId) =>
        edits.TryGetValue(pluginId, out var current) && original.TryGetValue(pluginId, out var before)
        && current.Any(kv => !string.Equals(Normalize(kv.Value), Normalize(before.GetValueOrDefault(kv.Key)), StringComparison.Ordinal));

    private static string Normalize(string? value) => (value ?? "").ReplaceLineEndings("\n").Trim();

    private Task SaveConfigAsync(PluginState plugin) =>
        RunOpAsync("cfg:" + plugin.Id, "Enregistrement…", async () =>
        {
            var before = original[plugin.Id];
            var changed = edits[plugin.Id]
                .Where(kv => !string.Equals(Normalize(kv.Value), Normalize(before.GetValueOrDefault(kv.Key)), StringComparison.Ordinal))
                .ToDictionary(kv => kv.Key, kv => kv.Value);
            await Plugins.SaveConfigAsync(plugin.Id, changed);
            edits.Remove(plugin.Id);
            original.Remove(plugin.Id);
            return plugin.Enabled ? "Réglages enregistrés ; la source a été redémarrée." : "Réglages enregistrés.";
        });

    private Task SetEnabledAsync(PluginState plugin, bool enabled) =>
        RunOpAsync("enable:" + plugin.Id, enabled ? "Activation…" : "Désactivation…", async () =>
        {
            await Plugins.SetEnabledAsync(plugin.Id, enabled);
            return plugin.State switch
            {
                PluginRunState.Failed => throw new InvalidOperationException(plugin.Error ?? "La source n'a pas pu démarrer."),
                PluginRunState.Unsupported => plugin.Error,
                _ => enabled ? "Activée." : "Désactivée.",
            };
        });

    private Task RunActionAsync(PluginState plugin, SourceAction action) =>
        RunOpAsync("action:" + plugin.Id, action.Label + "… terminez l'opération dans la fenêtre ouverte le cas échéant.", async () =>
        {
            var result = await Plugins.ExecuteActionAsync(plugin.Id, action.Id);
            statuses[plugin.Id] = await Plugins.GetStatusAsync(plugin.Id);
            return result.Ok ? result.Message ?? "Terminé." : throw new InvalidOperationException(result.Message ?? "Échec.");
        });

    private void RefreshSecretStates()
    {
        foreach (var secret in Plugins.Plugins.SelectMany(p => p.Descriptor.Secrets))
        {
            try
            {
                secretStates[secret.Name] = !string.IsNullOrWhiteSpace(Secrets.Get(secret.Name));
            }
            catch
            {
                secretStates[secret.Name] = false;
            }
        }
    }

    private async Task LoadTaskCountAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        activeTasks = await db.ForecastTasks.CountAsync(t => t.IsActive && t.ExternalId != TimeSheetHelper.Core.Forecast.ForecastTask.IgnoredExternalId);
        lastTaskSeenUtc = await db.ForecastTasks.MaxAsync(t => (DateTime?)t.LastSeenUtc);
    }

    private Task SyncAsync(string? collectorName) =>
        RunOpAsync(collectorName is null ? "sync:*" : "sync:" + collectorName, "Synchronisation en cours…", async () =>
        {
            var results = await Scheduler.RunNowAsync(collectorName);
            await RefreshStatusesAsync(Plugins.Plugins);
            var count = results.Sum(r => r.EventCount);
            var failed = results.Count(r => r.Outcome == CollectorSyncOutcome.Failed);
            return failed > 0
                ? throw new InvalidOperationException($"{count} événement(s) ; {failed} source(s) en échec (voir les cartes).")
                : $"Terminé : {count} événement(s).";
        });

    private Task SaveSecretAsync(PluginState plugin, SecretRequirement secret) =>
        RunOpAsync("secret:" + secret.Name, "Enregistrement…", async () =>
        {
            var value = secretInputs.GetValueOrDefault(secret.Name)?.Trim();
            if (string.IsNullOrEmpty(value))
                throw new InvalidOperationException("Valeur vide.");
            Secrets.Set(secret.Name, value);
            secretInputs[secret.Name] = null;
            RefreshSecretStates();
            await RefreshStatusesAsync([plugin]);
            return "Enregistré.";
        });

    private Task DeleteSecretAsync(PluginState plugin, SecretRequirement secret)
    {
        confirmDeleteSecret = null;
        return RunOpAsync("secret:" + secret.Name, "Suppression…", async () =>
        {
            Secrets.Delete(secret.Name);
            RefreshSecretStates();
            await RefreshStatusesAsync([plugin]);
            return "Supprimé.";
        });
    }

    private Task InstallFromPathAsync() =>
        RunOpAsync("install", "Installation…", async () =>
        {
            var result = await Plugins.InstallAsync(installPath!.Trim().Trim('"'));
            installPath = null;
            return result.Message;
        });

    private Task InstallFromUploadAsync(InputFileChangeEventArgs e) =>
        RunOpAsync("install", "Envoi et installation…", async () =>
        {
            var temp = Path.Combine(Path.GetTempPath(), $"tsh-plugin-{Guid.NewGuid():N}.zip");
            try
            {
                await using (var input = e.File.OpenReadStream(MaxUploadBytes))
                await using (var output = File.Create(temp))
                    await input.CopyToAsync(output);
                return (await Plugins.InstallAsync(temp)).Message;
            }
            finally
            {
                File.Delete(temp);
            }
        });

    private Task UninstallAsync(string packageId)
    {
        confirmUninstall = null;
        return RunOpAsync("package:" + packageId, "Désinstallation…", async () =>
        {
            await Plugins.UninstallAsync(packageId);
            return "Désinstallé.";
        });
    }

    private Task ForecastLoginAsync() =>
        RunOpAsync("forecast", "Connexion à Forecast… terminez l'autorisation dans la fenêtre du navigateur.", () =>
            ForecastOps.RunAsync<string?>("connexion", async ct =>
            {
                await using var client = await ForecastConnector.ConnectAsync(interactive: true, cancellationToken: ct);
                var tools = await client.ListToolsAsync(ct);
                forecastHasCredentials = ForecastConnector.HasCredentials;
                return $"Connecté à Forecast ({tools.Count} outil(s) disponibles). La connexion est conservée pour les prochaines utilisations.";
            }));

    private Task ForecastLogoutAsync() =>
        RunOpAsync("forecast", "Déconnexion…", async () =>
        {
            await ForecastConnector.SignOutAsync();
            forecastHasCredentials = ForecastConnector.HasCredentials;
            return "Connexion à Forecast oubliée.";
        });

    private Task ForecastSyncTasksAsync() =>
        RunOpAsync("forecast", "Lecture des tâches dans Forecast…", async () =>
        {
            var result = await ForecastOps.RunAsync("synchronisation des tâches", ct => TaskReader.SyncTasksAsync(ct));
            await LoadTaskCountAsync();
            return result.Warning is not null ? throw new InvalidOperationException(result.Warning) : result.Summary;
        });

    public void Dispose()
    {
        disposed = true;
        Scheduler.Changed -= OnChanged;
        Plugins.Changed -= OnPluginsChanged;
        refreshTimer?.Dispose();
    }
}
