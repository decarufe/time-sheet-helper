<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TimeSheetHelper.Core\TimeSheetHelper.Core.csproj" />
    <ProjectReference Include="..\TimeSheetHelper.Plugins.Abstractions\TimeSheetHelper.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\TimeSheetHelper.Storage\TimeSheetHelper.Storage.csproj" />
    <ProjectReference Include="..\TimeSheetHelper.Forecast\TimeSheetHelper.Forecast.csproj" />
    <ProjectReference Include="..\TimeSheetHelper.Engine\TimeSheetHelper.Engine.csproj" />
  </ItemGroup>

  <!-- Source plugins shipped with the application: loaded from plugins\<PackageDir>\ at run time, never referenced. -->
  <ItemGroup>
    <BundledPlugin Include="..\TimeSheetHelper.Collectors.Windows\TimeSheetHelper.Collectors.Windows.csproj" PackageDir="windows-activity" />
    <BundledPlugin Include="..\TimeSheetHelper.Collectors.DevOps\TimeSheetHelper.Collectors.DevOps.csproj" PackageDir="devops" />
    <BundledPlugin Include="..\TimeSheetHelper.Collectors.Microsoft365\TimeSheetHelper.Collectors.Microsoft365.csproj" PackageDir="microsoft-365" />
  </ItemGroup>

  <!--
    Referenced without their output so that a restore of the application also restores them (the targets below build and
    publish them), and so that they are built before it.
  -->
  <ItemGroup>
    <ProjectReference Include="@(BundledPlugin)" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TimeSheetHelper.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <AssemblyName>TimeSheetHelper</AssemblyName>
    <RootNamespace>TimeSheetHelper.App</RootNamespace>
  </PropertyGroup>

  <!--
    Publishes each bundled plugin (framework-dependent, whatever the application's own runtime identifier) next to the
    executable. A plugin package is a folder with its plugin.json, its assembly and its dependencies.
  -->
  <Target Name="StageBundledPlugins" AfterTargets="Build" Condition="'@(BundledPlugin)' != ''">
    <PropertyGroup>
      <_PluginStageRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)', 'plugins'))</_PluginStageRoot>
    </PropertyGroup>
    <MSBuild Projects="@(BundledPlugin)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(_PluginStageRoot)%(BundledPlugin.PackageDir)\;SelfContained=false;PublishSingleFile=false;PublishTrimmed=false"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun;PublishTrimmed" />
    <!-- The manifest sits in the plugin project but is not part of its output (it would collide between plugins). -->
    <Copy SourceFiles="%(BundledPlugin.RootDir)%(BundledPlugin.Directory)plugin.json"
          DestinationFolder="$(_PluginStageRoot)%(BundledPlugin.PackageDir)\" />
  </Target>

  <Target Name="CopyBundledPluginsToPublish" AfterTargets="Publish" DependsOnTargets="StageBundledPlugins">
    <ItemGroup>
      <_StagedPluginFile Include="$(OutDir)plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_StagedPluginFile)"
          DestinationFiles="@(_StagedPluginFile->'$(PublishDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Microsoft.AspNetCore.App.Internal.Assets only publishes _framework/blazor.web.js when OutputType is "Exe"
    (target _AddBlazorFrameworkStaticWebAssets). This app is a WinExe (tray icon, no console), so without this
    target the script is a 404 and no page is interactive. Same logic, for WinExe only.
  -->
  <Target Name="_AddBlazorFrameworkStaticWebAssetsForWinExe"
          AfterTargets="_AddBlazorFrameworkStaticWebAssets"
          Condition="'$(OutputType)' == 'WinExe' AND '$(BlazorFrameworkStaticWebAssetRoot)' != ''">
    <ItemGroup>
      <_TshFrameworkCandidate Include="$(BlazorFrameworkStaticWebAssetRoot)\blazor.web.js" RelativePath="_framework/blazor.web.js" />
      <_TshFrameworkCandidate Remove="@(_TshFrameworkCandidate)" Condition="!EXISTS('%(Identity)')" />
    </ItemGroup>
    <DefineStaticWebAssets
      Condition="'@(_TshFrameworkCandidate->Count())' != '0'"
      CandidateAssets="@(_TshFrameworkCandidate)"
      ContentRoot="$(BlazorFrameworkStaticWebAssetRoot)"
      SourceId="$(PackageId)"
      SourceType="Discovered"
      AssetKind="All"
      AssetMode="CurrentProject"
      AssetRole="Primary"
      FingerprintCandidates="true"
      BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_TshFrameworkAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints
      Condition="'@(_TshFrameworkAsset)' != ''"
      CandidateAssets="@(_TshFrameworkAsset)"
      ExistingEndpoints=""
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_TshFrameworkEndpoint" />
    </DefineStaticWebAssetEndpoints>
    <ItemGroup>
      <StaticWebAsset Include="@(_TshFrameworkAsset)" />
      <StaticWebAssetEndpoint Include="@(_TshFrameworkEndpoint)" />
    </ItemGroup>
  </Target>

</Project>
